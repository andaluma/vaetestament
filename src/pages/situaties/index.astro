---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const situaties = await getCollection('situaties');

const canonical = 'https://vaetestament.nl/situaties/';
---

<BaseLayout
  title="Situaties - Welk DIFC-testament past bij u? - VAEtestament"
  description="Bekijk concrete situaties van Nederlandse vastgoedeigenaren in de VAE en ontdek welk DIFC-testament (Property Will of Full Will) bij uw situatie past."
  canonical={canonical}
>
  <main class="page">
    <section class="article-hero has-image" style="--hero-image: url('https://images.unsplash.com/photo-1518684079-3c830dcef090?w=1600&q=85&auto=format&fit=crop')">
      <div class="container">
        <span class="hero-eyebrow fade-up">Praktijkvoorbeelden</span>
        <h1 class="fade-up delay-1">Welk testament past bij uw situatie?</h1>
        <p class="lede fade-up delay-2">Elke situatie is anders. Hieronder vindt u concrete voorbeelden van Nederlandse vastgoedeigenaren in de VAE, met per situatie een helder advies: Property Will of Full Will.</p>
      </div>
    </section>

    <nav class="breadcrumbs" aria-label="Broodkruimels">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">Situaties</span>
    </nav>

    <section class="article-body" style="max-width:var(--max-prose);margin:0 auto;padding:2rem 1.5rem 4rem;">
      <ul class="related-list" style="list-style:none;padding:0;">
        {situaties.map((entry) => {
          const slug = entry.id.replace(/\.(md|mdx)$/, '');
          return (
            <li style="margin-bottom:1rem;">
              <a href={`/situaties/${slug}/`} style="display:block;padding:1.25rem 1.5rem;background:var(--cream-dark);border-radius:8px;text-decoration:none;color:inherit;transition:box-shadow 0.2s;">
                <strong style="display:block;font-family:var(--font-display);font-size:1.15rem;color:var(--teal);margin-bottom:0.35rem;">{entry.data.title}</strong>
                <span style="font-size:0.9rem;color:var(--mid);line-height:1.5;">{entry.data.meta_description}</span>
                {entry.data.result && (
                  <span style="display:inline-block;margin-top:0.5rem;background:var(--gold);color:#fff;padding:0.2rem 0.6rem;border-radius:3px;font-size:0.78rem;font-weight:500;">{entry.data.result}</span>
                )}
              </a>
            </li>
          );
        })}
      </ul>

      <div style="text-align:center;margin-top:2rem;">
        <p style="color:var(--mid);margin-bottom:1rem;">Staat uw situatie er niet bij? In 15 minuten kunnen wij vaststellen welk testament bij u past.</p>
        <a href="https://cal.com/vaetestament.nl" class="btn btn-gold">Plan een gratis gesprek</a>
      </div>
    </section>
  </main>
</BaseLayout>
