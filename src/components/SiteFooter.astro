---
// SiteFooter - dark footer matching the live homepage.

interface Props { locale?: 'nl' | 'en' | 'es'; }
const { locale = 'nl' } = Astro.props;

const FOOTER_STRINGS: Record<string, {
  articles: string; articlesHref: string;
  about: string; aboutHref: string;
  situations?: string; situationsHref?: string;
  privacy: string; privacyHref: string;
  terms: string; termsHref: string;
  contact: string; contactHref: string;
  legal: string;
}> = {
  nl: {
    articles: 'Artikelen', articlesHref: '/artikelen/',
    about: 'Over André', aboutHref: '/over-andre/',
    situations: 'Situaties', situationsHref: '/situaties/',
    privacy: 'Privacybeleid', privacyHref: '/privacybeleid.html',
    terms: 'Algemene voorwaarden', termsHref: '/algemene-voorwaarden.html',
    contact: 'Contact', contactHref: '/#kennismaking',
    legal: 'VAEtestament is geen advocatenkantoor en verleent geen juridisch advies. Wij begeleiden u bij de DIFC-portaalregistratie. Voor juridisch advies verwijzen wij u door naar ervaren DIFC-advocaten.',
  },
  en: {
    articles: 'Articles', articlesHref: '/articles/',
    about: 'About André', aboutHref: '/about/',
    privacy: 'Privacy policy', privacyHref: '/privacy-policy.html',
    terms: 'Terms and conditions', termsHref: '/terms-and-conditions.html',
    contact: 'Contact', contactHref: '/#consultation',
    legal: 'UAEpropertyWills is not a law firm and does not provide legal advice. We guide you through the DIFC portal registration. For legal advice, we refer you to experienced DIFC lawyers.',
  },
  es: {
    articles: 'Artículos', articlesHref: '/articulos/',
    about: 'Sobre André', aboutHref: '/sobre-andre/',
    privacy: 'Política de privacidad', privacyHref: '/politica-de-privacidad.html',
    terms: 'Términos y condiciones', termsHref: '/terminos-y-condiciones.html',
    contact: 'Contacto', contactHref: '/#consulta',
    legal: 'VAEtestament no es un bufete de abogados y no ofrece asesoramiento legal. Le guiamos en el registro del portal DIFC. Para asesoramiento legal, le derivamos a abogados DIFC experimentados.',
  },
};
const t = FOOTER_STRINGS[locale] || FOOTER_STRINGS.nl;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-logo">{locale === 'en' ? <Fragment>UAE<span>propertyWills</span></Fragment> : <Fragment>VAE<span>testament</span></Fragment>}</div>
    <ul class="footer-links">
      <li><a href={t.articlesHref}>{t.articles}</a></li>
      <li><a href={t.aboutHref}>{t.about}</a></li>
      {t.situations && <li><a href={t.situationsHref}>{t.situations}</a></li>}
      <li><a href={t.privacyHref}>{t.privacy}</a></li>
      <li><a href={t.termsHref}>{t.terms}</a></li>
      <li><a href={t.contactHref}>{t.contact}</a></li>
    </ul>
    <p class="footer-legal">
      {t.legal}<br>
      &copy; 2026 Andaluma OÜ (Estonia), trading as {locale === 'en' ? 'UAEpropertyWills' : 'VAEtestament'}.
    </p>
  </div>
</footer>

<style is:global>
  .site-footer {
    background: var(--dark);
    padding: 56px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 80px;
  }
  .site-footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .footer-logo {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .footer-logo span { color: var(--gold); }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .footer-links a {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
    transition: color 0.15s;
  }
  .footer-links a:hover { color: rgba(255, 255, 255, 0.85); }
  .footer-legal {
    width: 100%;
    margin: 12px 0 0;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.28);
    font-weight: 300;
    line-height: 1.55;
  }
  @media (max-width: 720px) {
    .site-footer-inner { flex-direction: column; align-items: flex-start; padding: 0 20px; }
  }
</style>
