<script is:inline>
  /* FAQ accordion */
  document.querySelectorAll('.faq-question').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var item = btn.parentElement;
      var isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(function(i) { i.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });

  /* Referral attribution: capture ?ref= from URL, inject into Stripe links */
  (function () {
    var params = new URLSearchParams(window.location.search);
    var ref = params.get('ref');
    if (ref) {
      sessionStorage.setItem('vt_ref', ref);
      params.delete('ref');
      var clean = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
      history.replaceState(null, '', clean);
    }

    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href*="buy.stripe.com"]');
      if (!link) return;
      var storedRef = sessionStorage.getItem('vt_ref');
      if (!storedRef) return;
      e.preventDefault();
      var url = new URL(link.href);
      url.searchParams.set('client_reference_id', 'ref-' + storedRef);
      window.open(url.toString(), '_blank');
    });
  })();
</script>
