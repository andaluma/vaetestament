---
// BaseLayout - wraps every page with:
// - meta tags (title, description, OG, Twitter card)
// - canonical link
// - hreflang scaffolding (self-ref + x-default; cross-domain EN/ES added later)
// - Google Fonts (Cormorant + Jost) - same families as live site
// - favicon
// - global stylesheet
//
// All SEO/AEO-critical tags are emitted here so every page inherits them
// without per-page boilerplate.

import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TierCheckModal from '../components/TierCheckModal.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
import AIAskPanel from '../components/AIAskPanel.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  /** JSON-LD blocks to inject in <head> as raw <script type="application/ld+json">. */
  jsonLd?: Record<string, unknown>[];
  /** Article slug - passed to the WhatsApp FAB for context-aware greeting. */
  articleSlug?: string;
  /** Article title - passed to the WhatsApp FAB for context-aware greeting. */
  articleTitle?: string;
  /** Emit <meta name="robots" content="noindex,follow"> - for thin/utility pages. */
  noindex?: boolean;
  /** Hide the fixed top nav (defaults to showing it). */
  hideNav?: boolean;
  /** Hide the site footer (defaults to showing it). */
  hideFooter?: boolean;
  /** Page locale - controls lang attr, OG locale, and nav/footer chrome. */
  locale?: 'nl' | 'en' | 'es';
  /** Cross-locale alternates: { nl: '/path', en: '/path' }. Emits hreflang tags. */
  alternates?: Record<string, string>;
}

const LOCALE_DOMAINS: Record<string, string> = {
  nl: 'https://vaetestament.nl',
  en: 'https://uaepropertywills.com',
  es: 'https://PLACEHOLDER-ES-DOMAIN.com',
};

const OG_LOCALES: Record<string, string> = {
  nl: 'nl_NL',
  en: 'en_GB',
  es: 'es_ES',
};

const {
  title,
  description,
  canonical: canonicalProp,
  ogImage: ogImageProp,
  ogType = 'website',
  publishDate,
  updatedDate,
  author,
  jsonLd = [],
  noindex = false,
  hideNav = false,
  hideFooter = false,
  locale = 'nl',
  alternates = {},
} = Astro.props;

const localeDomain = LOCALE_DOMAINS[locale] || LOCALE_DOMAINS.nl;
const canonical = canonicalProp || `${localeDomain}${Astro.url.pathname}`;
const ogImage = ogImageProp || `${localeDomain}/og-default.png`;
const siteName = locale === 'en' ? 'UAEpropertyWills' : 'VAEtestament';
const ogLocale = OG_LOCALES[locale] || 'nl_NL';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex,follow" />}

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={locale} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={locale === 'nl' ? canonical : (alternates.nl ? `${LOCALE_DOMAINS.nl}${alternates.nl}` : `${LOCALE_DOMAINS.nl}${Astro.url.pathname}`)} />
    {Object.entries(alternates).map(([lang, path]) => (
      <link rel="alternate" hreflang={lang} href={`${LOCALE_DOMAINS[lang] || ''}${path}`} />
    ))}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content={ogLocale} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {publishDate && (
      <meta property="article:published_time" content={publishDate.toISOString()} />
    )}
    {updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    {author && <meta name="author" content={author} />}

    <link rel="icon" type={locale === 'en' ? 'image/svg+xml' : 'image/png'} href={locale === 'en' ? '/favicon-en.svg' : '/favicon.png'} />
    <link rel="apple-touch-icon" href={locale === 'en' ? '/favicon-en.svg' : '/favicon.png'} />
    <meta name="theme-color" content="#0C4A45" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500;600&display=swap"
        rel="stylesheet"
      />
    </noscript>

    {jsonLd.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}
  </head>
  <body>
    {!hideNav && <SiteNav locale={locale} />}
    <slot />
    {!hideFooter && <SiteFooter locale={locale} />}
    <TierCheckModal />
    <AIAskPanel slug={Astro.props.articleSlug ?? ''} locale={locale} />
    <WhatsAppFab slug={Astro.props.articleSlug ?? ''} title={Astro.props.articleTitle ?? ''} locale={locale} />
  </body>
</html>
