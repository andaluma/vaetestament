---
// Cookie consent banner. GDPR compliant, Dutch language.
// Tracking only loads after an explicit "Accepteren" click.
// Choice stored in localStorage under 'cookie_consent' = 'all' | 'necessary'.
---

<div id="cookie-banner" style="display:none" role="region" aria-label="Cookiemelding" tabindex="-1">
  <div class="cb-inner">
    <div class="cb-text">
      <p class="cb-value">Wij gebruiken cookies van Meta en Google om u relevante inhoud te tonen en ons websitebereik te meten.</p>
      <a class="cb-privacy" href="/privacybeleid.html">Privacybeleid</a>
    </div>
    <div class="cb-actions">
      <button id="cb-accept" type="button">Accepteren</button>
      <button id="cb-necessary" type="button">Alleen noodzakelijk</button>
    </div>
  </div>
</div>

<style>
  #cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    background: #F6F1E7;
    border-top: 2px solid #C8A44A;
    box-shadow: 0 -2px 14px rgba(12, 74, 69, 0.10);
    font-family: 'Jost', sans-serif;
    justify-content: center; /* JS sets display:flex when shown */
  }
  .cb-inner {
    width: 100%;
    max-width: 1100px;
    padding: 0.9rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cb-text {
    flex: 1 1 260px;
    min-width: 0;
  }
  .cb-value {
    margin: 0;
    color: #0C4A45;
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .cb-privacy {
    display: inline-block;
    margin-top: 0.3rem;
    color: #0C4A45;
    font-size: 0.8rem;
    text-decoration: underline;
    opacity: 0.7;
  }
  .cb-privacy:hover { opacity: 1; }
  .cb-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }
  #cb-accept {
    background: #0C4A45;
    color: #fff;
    border: none;
    padding: 0.7rem 1.9rem;
    border-radius: 4px;
    font-family: 'Jost', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    white-space: nowrap;
  }
  #cb-accept:hover { background: #0a3d39; }
  #cb-necessary {
    background: none;
    border: none;
    padding: 0.5rem;
    color: #6B6B6B;
    font-family: 'Jost', sans-serif;
    font-size: 0.85rem;
    text-decoration: underline;
    cursor: pointer;
    white-space: nowrap;
  }
  #cb-necessary:hover { color: #0C4A45; }
  #cookie-banner:focus { outline: 2px solid #0C4A45; outline-offset: -2px; }

  @media (max-width: 640px) {
    .cb-inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.85rem;
      padding: 1rem 1.1rem 1.15rem;
    }
    .cb-text {
      flex: 0 0 auto; /* avoid basis becoming a tall height in column layout */
    }
    .cb-actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.55rem;
    }
    #cb-accept {
      width: 100%;
      padding: 0.9rem;
      font-size: 0.98rem;
    }
    #cb-necessary {
      width: 100%;
      text-align: center;
      padding: 0.65rem;
    }
  }
</style>

<script is:inline>
  (function () {
    var CONSENT_KEY = 'cookie_consent';

    function loadGA4() {
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-P2NDF2W2N4';
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', 'G-P2NDF2W2N4');
    }

    function loadPixel() {
      !function (f, b, e, v, n, t, s) {
        if (f.fbq) return; n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0';
        n.queue = []; t = b.createElement(e); t.async = !0;
        t.src = v; s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1361034515943477');
      fbq('track', 'PageView');

      // ViewContent on the pricing (homepage) and article pages. The static
      // site re-runs this script on every page load, so path detection is
      // enough; no per-page wiring needed.
      var path = window.location.pathname;
      if (path === '/' || path.indexOf('/artikelen/') === 0) {
        fbq('track', 'ViewContent');
      }
    }

    // Consent-safe tracker. Callers can fire events anywhere; this no-ops
    // until the visitor has accepted marketing cookies and the pixel loaded.
    window.vaeTrack = function (event, params) {
      if (window.fbq) fbq('track', event, params || {});
    };

    function loadTracking() {
      loadGA4();
      loadPixel();
    }

    function onKeydown(e) {
      // ESC dismisses to necessary-only.
      if (e.key === 'Escape' || e.keyCode === 27) chooseNecessary();
    }

    function hideBanner() {
      var banner = document.getElementById('cookie-banner');
      if (banner) banner.style.display = 'none';
      document.removeEventListener('keydown', onKeydown);
    }

    function chooseAll() {
      localStorage.setItem(CONSENT_KEY, 'all');
      hideBanner();
      loadTracking();
    }

    function chooseNecessary() {
      localStorage.setItem(CONSENT_KEY, 'necessary');
      hideBanner();
    }

    var wired = false;
    function showBanner() {
      var banner = document.getElementById('cookie-banner');
      if (!banner) return;
      if (!wired) {
        wired = true;
        document.getElementById('cb-accept').addEventListener('click', chooseAll);
        document.getElementById('cb-necessary').addEventListener('click', chooseNecessary);
      }
      banner.style.display = 'flex';
      document.addEventListener('keydown', onKeydown);
      // Focus moves to the banner on appearance.
      if (typeof banner.focus === 'function') banner.focus();
    }

    // First-visit reveal: delayed 4s OR on first scroll, whichever comes first.
    function armFirstVisit() {
      var shown = false;
      function trigger() {
        if (shown) return;
        shown = true;
        window.removeEventListener('scroll', trigger);
        showBanner();
      }
      setTimeout(trigger, 4000);
      window.addEventListener('scroll', trigger, { passive: true });
    }

    // Public: footer "Cookievoorkeuren" link reopens the banner and resets choice.
    window.openCookieSettings = function () {
      localStorage.removeItem(CONSENT_KEY);
      if (document.getElementById('cookie-banner')) showBanner();
      else document.addEventListener('DOMContentLoaded', showBanner);
      return false;
    };

    // Check existing consent
    var stored = localStorage.getItem(CONSENT_KEY);
    if (stored === 'all') {
      loadTracking();
    } else if (stored === 'necessary') {
      // do nothing, banner stays hidden
    } else if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', armFirstVisit);
    } else {
      armFirstVisit();
    }

    // Delegated funnel events. Attached on every page regardless of consent;
    // vaeTrack no-ops until the pixel is loaded, so these are consent-safe.
    document.addEventListener('click', function (e) {
      // InitiateCheckout: any Stripe payment link. Optional data-value (EUR)
      // on the anchor adds purchase value; falls back to no value.
      var stripe = e.target.closest('a[href*="buy.stripe.com"]');
      if (stripe) {
        var params = { currency: 'EUR' };
        var v = parseFloat(stripe.getAttribute('data-value'));
        if (!isNaN(v)) params.value = v;
        window.vaeTrack('InitiateCheckout', params);
        return;
      }
      // Schedule: cal.com booking-link click. This is booking INTENT, not a
      // confirmed booking, so it uses the standard Schedule event rather than
      // Lead. Lead stays reserved for confirmed conversions (newsletter). True
      // booking-success -> Lead needs cal.com's server-side/Meta integration.
      var cal = e.target.closest('a[href*="cal.com"]');
      if (cal) window.vaeTrack('Schedule', { content_name: 'consultation' });
    });
  })();
</script>
