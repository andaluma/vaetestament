<script is:inline>
  (function () {
    var form = document.getElementById('vkLmForm');
    if (!form) return;
    var status = form.querySelector('.lm-status');
    var button = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var fd = new FormData(form);
      if (fd.get('website')) return;
      var email = (fd.get('email') || '').toString().trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        status.textContent = 'Voer een geldig e-mailadres in.';
        status.className = 'lm-status err';
        status.hidden = false;
        return;
      }
      button.disabled = true;
      status.textContent = 'Even geduld…';
      status.className = 'lm-status';
      status.hidden = false;
      try {
        var res = await fetch('https://api.vaetestament.nl/v1/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email: email,
            slug: 'gespreksgids',
            source: 'leadmagnet-kinderen'
          })
        });
        if (!res.ok) throw new Error('subscribe ' + res.status);
        status.textContent = 'Bedankt! Check uw inbox voor een bevestigingse-mail. Na bevestiging ontvangt u de gids.';
        status.className = 'lm-status ok';
        form.querySelector('input[type="email"]').value = '';
      } catch (err) {
        status.textContent = 'Aanmelden lukte niet. Probeer het later opnieuw of mail support@vaetestament.nl.';
        status.className = 'lm-status err';
      } finally {
        button.disabled = false;
      }
    });
  })();
</script>
