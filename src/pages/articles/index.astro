---
// /articles/ - English article hub. Same structure as /artikelen/.

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierCheckButton from '../../components/TierCheckButton.astro';
import BookCallButton from '../../components/BookCallButton.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const siteRoot = 'https://uaepropertywills.com';
const canonical = `${siteRoot}${Astro.url.pathname}`;

const allArticles = await getCollection('articles_en');

const clusters = [
  {
    key: 'waarom',
    title: 'Why it matters',
    intro:
      'What a DIFC will is, why it is essential for foreign property owners in the UAE, and what happens if you do not arrange one.',
  },
  {
    key: 'hoe',
    title: 'How it works',
    intro:
      'The DIFC registration step by step, and what your heirs face if there is no will.',
  },
  {
    key: 'keuze',
    title: 'Which option fits you',
    intro:
      'DIFC will or home-country will, individual or as a couple, and what it all costs.',
  },
] as const;

const articlesByCluster = clusters.map((c) => ({
  ...c,
  items: allArticles
    .filter((a) => a.data.cluster === c.key)
    .map((a) => ({
      slug: a.id.replace(/\.(md|mdx)$/, ''),
      title: a.data.title,
      meta_description: a.data.meta_description,
      readMinutes: Math.max(1, Math.round((a.body ?? '').split(/\s+/).length / 200)),
    }))
    .sort((a, b) => a.title.localeCompare(b.title)),
}));

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': canonical,
  name: 'Articles - UAEpropertyWills',
  description:
    'Practical guides on DIFC wills for foreign owners of UAE property. Three clusters: why it matters, how it works, which option fits you.',
  url: canonical,
  inLanguage: 'en',
  isPartOf: {
    '@type': 'WebSite',
    name: 'UAEpropertyWills',
    url: canonical.replace(/\/articles\/$/, '/'),
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allArticles.length,
    itemListElement: articlesByCluster.flatMap((c, ci) =>
      c.items.map((a, ai) => ({
        '@type': 'ListItem',
        position: ci * 100 + ai + 1,
        url: `${canonical}${a.slug}/`,
        name: a.title,
      })),
    ),
  },
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: canonical.replace(/\/articles\/$/, '/') },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: canonical },
  ],
};
---

<BaseLayout
  title="Articles - UAEpropertyWills"
  description="Practical guides on DIFC wills for foreign owners of UAE property: why it matters, how it works, and which option fits your situation."
  canonical={canonical}
  jsonLd={[collectionJsonLd, breadcrumbJsonLd]}
  locale="en"
  alternates={{ nl: '/artikelen/' }}
>
  <main class="page">
    <section class="hub-hero">
      <div class="container">
        <span class="hero-eyebrow fade-up">Knowledge hub</span>
        <h1 class="fade-up delay-1">DIFC wills <em>explained</em>.</h1>
        <p class="lede fade-up delay-2">
          Three questions, in this order:
          <strong>why it matters</strong> &rarr;
          <strong>how it works</strong> &rarr;
          <strong>which option fits you</strong>.
          Eight articles, five minutes each, in plain English.
        </p>
      </div>
    </section>

    <nav class="breadcrumbs" style="max-width:1100px;padding:28px 32px 0;">
      <a href="/">Home</a>
      <span aria-hidden="true"> &rsaquo; </span>
      <span aria-current="page">Articles</span>
    </nav>

    <div class="hub-body">
      {articlesByCluster.map((c, idx) => (
        <section class="cluster" aria-labelledby={`cluster-${c.key}`}>
          <header class="cluster-header">
            <p class="cluster-num">{idx + 1}</p>
            <div>
              <h2 id={`cluster-${c.key}`}>{c.title}</h2>
              <p>{c.intro}</p>
            </div>
          </header>

          <ul class="cluster-list">
            {c.items.map((a) => (
              <li>
                <a href={`/articles/${a.slug}/`}>
                  <h3>{a.title}</h3>
                  <p>{a.meta_description}</p>
                  <span class="read-time">{a.readMinutes} min read</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <section class="hub-cta">
        <p class="section-label">Did not find your question?</p>
        <h2>Ask directly</h2>
        <p>
          Use the online assistant (button at the bottom right) for a quick answer, determine which
          package suits you, or schedule a free 15-minute consultation.
        </p>
        <div class="cta-row">
          <TierCheckButton />
          <BookCallButton cluster="keuze" variant="subtle" label="Schedule a free consultation" />
        </div>
      </section>

      <div style="margin: 48px auto 0; max-width: 720px;">
        <NewsletterSignup locale="en" />
      </div>
    </div>
  </main>
</BaseLayout>
