---
// Dynamic article route - renders every entry in the `articles_en` collection
// at /articles/{slug}. Same visual design as the NL /artikelen/ pages.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierCheckButton from '../../components/TierCheckButton.astro';
import BookCallButton from '../../components/BookCallButton.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const DEFAULT_HERO =
  'https://images.unsplash.com/photo-1518684079-3c830dcef090?w=1600&q=85&auto=format&fit=crop';

export async function getStaticPaths() {
  const articles = await getCollection('articles_en');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const data = entry.data;
const slug = entry.id.replace(/\.(md|mdx)$/, '');
const enDomain = 'https://uaepropertywills.com';
const canonical = `${enDomain}${Astro.url.pathname}`;
const heroImage = data.hero_image || DEFAULT_HERO;

const bodyText = entry.body ?? '';
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

const allArticles = await getCollection('articles_en');
const slugIndex = new Map(
  allArticles.map((a) => [a.id.replace(/\.(md|mdx)$/, ''), a]),
);
const relatedEntries = (data.related ?? [])
  .map((s) => slugIndex.get(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': data.schema_type,
  headline: data.title,
  description: data.meta_description,
  image: heroImage,
  datePublished: data.publish_date.toISOString(),
  ...(data.updated_date && { dateModified: data.updated_date.toISOString() }),
  author: {
    '@type': 'Person',
    name: data.author,
    url: canonical.replace(/\/articles\/.*$/, '/about/'),
  },
  publisher: {
    '@type': 'Organization',
    name: 'UAEpropertyWills',
    legalName: 'Andaluma OÜ',
    url: canonical.replace(/\/articles\/.*$/, '/'),
    logo: {
      '@type': 'ImageObject',
      url: canonical.replace(/\/articles\/.*$/, '/favicon-en.svg'),
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: data.keywords.join(', '),
  inLanguage: 'en',
};

const siteRoot = canonical.replace(/\/articles\/.*$/, '/');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteRoot },
    { '@type': 'ListItem', position: 2, name: 'Articles', item: `${siteRoot}articles/` },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ],
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((qa) => ({
          '@type': 'Question',
          name: qa.q,
          acceptedAnswer: { '@type': 'Answer', text: qa.a },
        })),
      }
    : null;

const jsonLd = [articleJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const clusterLabels: Record<string, string> = {
  waarom: 'Why it matters',
  hoe: 'How it works',
  keuze: 'Which option fits you',
};
const clusterLabel = clusterLabels[data.cluster] ?? null;

const publishDateFmt = data.publish_date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${data.title} - UAEpropertyWills`}
  description={data.meta_description}
  canonical={canonical}
  ogType="article"
  ogImage={heroImage}
  publishDate={data.publish_date}
  updatedDate={data.updated_date}
  author={data.author}
  jsonLd={jsonLd}
  articleSlug={slug}
  articleTitle={data.title}
  locale="en"
  alternates={data.nl_slug ? { nl: `/artikelen/${data.nl_slug}/` } : {}}
>
  <main class="page">
    <section
      class={`article-hero ${heroImage ? 'has-image' : ''}`}
      style={`--hero-image: url('${heroImage}')`}
    >
      <div class="container">
        {clusterLabel && <span class="hero-eyebrow fade-up">{clusterLabel}</span>}
        <h1 class="fade-up delay-1">{data.title}</h1>
        <p class="lede fade-up delay-2">{data.meta_description}</p>
        <p class="meta fade-up delay-3">
          <span>By <a href="/about/" rel="author">{data.author}</a></span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={data.publish_date.toISOString()}>{publishDateFmt}</time>
          <span aria-hidden="true">&middot;</span>
          <span>{readMinutes} min read</span>
        </p>
      </div>
    </section>

    <nav class="breadcrumbs" aria-label="Breadcrumbs">
      <a href="/">Home</a>
      <span aria-hidden="true"> &rsaquo; </span>
      <a href="/articles/">Articles</a>
      <span aria-hidden="true"> &rsaquo; </span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <article class="article-body">
      <Content />
    </article>

    <section class="cta-block" aria-labelledby="cta-heading">
      <p class="section-label">Next step</p>
      <h2 id="cta-heading">Which package suits your situation?</h2>
      <p>Five short questions and you will know which tier fits best. Or schedule a free 15-minute consultation first.</p>
      <div class="cta-row">
        <button
          type="button"
          class="btn btn-gold btn-lg"
          onclick={`openTierCheck(${JSON.stringify(slug)})`}
        >Find your tier</button>
        <BookCallButton slug={slug} cluster={data.cluster} variant="subtle" label="Schedule a free consultation" />
      </div>
    </section>

    {data.faq.length > 0 && (
      <section class="faq-block" aria-labelledby="faq-heading">
        <p class="section-label">Frequently asked questions</p>
        <h2 id="faq-heading">What readers often ask</h2>
        {data.faq.map((qa) => (
          <div class="faq-item">
            <h3>{qa.q}</h3>
            <p>{qa.a}</p>
          </div>
        ))}
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section class="related-block" aria-labelledby="related-heading">
        <p class="section-label" style="text-align:center;display:block;">Further reading</p>
        <h2 id="related-heading">Related articles</h2>
        <ul class="related-list">
          {relatedEntries.map((rel) => {
            const relSlug = rel.id.replace(/\.(md|mdx)$/, '');
            return (
              <li>
                <a href={`/articles/${relSlug}/`}>
                  <strong>{rel.data.title}</strong>
                  <span>{rel.data.meta_description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
