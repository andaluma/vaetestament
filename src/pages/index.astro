---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'VAEtestament - DIFC-testament voor Nederlanders met VAE-vastgoed';
const description = 'Bescherm uw VAE-vastgoed met een DIFC-testament. Speciaal voor Nederlandse niet-ingezetenen. Drie heldere opties, transparante prijzen.';
const canonical = 'https://vaetestament.nl/';
const ogImage = 'https://vaetestament.nl/og-default.png';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://vaetestament.nl/#organization",
    "name": "VAEtestament",
    "legalName": "Andaluma OÜ",
    "url": "https://vaetestament.nl/",
    "logo": "https://vaetestament.nl/logo-nav.png",
    "description": "Nederlandse dienst voor het registreren van DIFC-testamenten voor Nederlandse eigenaren van vastgoed in de Verenigde Arabische Emiraten.",
    "founder": {
      "@type": "Person",
      "name": "André van Wijngaarden",
      "url": "https://vaetestament.nl/over-andre"
    },
    "areaServed": ["NL", "AE"],
    "inLanguage": "nl-NL",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "support@vaetestament.nl",
      "telephone": "+31616146007",
      "contactType": "customer support",
      "availableLanguage": ["nl", "en", "es"]
    },
    "sameAs": ["https://www.linkedin.com/in/adriaanvanwijngaarden"]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://vaetestament.nl/#website",
    "url": "https://vaetestament.nl/",
    "name": "VAEtestament",
    "inLanguage": "nl-NL",
    "publisher": { "@id": "https://vaetestament.nl/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "name": "VAEtestament",
        "url": "https://vaetestament.nl",
        "description": "DIFC-testament begeleiding voor Nederlandse eigenaren van VAE-vastgoed. Bescherm uw erfopvolging met een rechtsgeldig testament in de VAE.",
        "founder": {
          "@type": "Person",
          "name": "André van Wijngaarden"
        },
        "areaServed": {
          "@type": "Country",
          "name": "Netherlands"
        },
        "serviceType": "DIFC-testament registratiebegeleiding",
        "offers": [
          {
            "@type": "Offer",
            "name": "Zelf & Zeker",
            "price": "497",
            "priceCurrency": "EUR",
            "description": "Videocursus met stap-voor-stap portaalbegeleiding voor zelfstandige DIFC-testament registratie"
          },
          {
            "@type": "Offer",
            "name": "Samen Registreren",
            "price": "797",
            "priceCurrency": "EUR",
            "description": "40 minuten begeleide portaalsessie voor DIFC-testament registratie"
          },
          {
            "@type": "Offer",
            "name": "Volledig Ontzorgd",
            "price": "1499",
            "priceCurrency": "EUR",
            "description": "Volledig begeleide DIFC-testament registratie inclusief introductie bij gecertificeerde advocaat"
          }
        ],
        "sameAs": [
          "https://cal.com/vaetestament.nl/15min"
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Geldt de Sharia ook voor mij als niet-moslim?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In veel gevallen wel. De VAE past bij overlijden in de regel lokaal erfrecht toe op bezittingen die zich op haar grondgebied bevinden - ongeacht uw nationaliteit of religie. Voor niet-moslims kan dit betekenen dat het standaardregime gebaseerd op de Sharia van toepassing is. Een DIFC-testament biedt niet-moslims de mogelijkheid hier vooraf van af te wijken via een rechtsgeldig geregistreerd testament."
            }
          },
          {
            "@type": "Question",
            "name": "Dekt mijn Nederlandse testament mijn VAE-vastgoed ook?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Doorgaans niet. Een Nederlands testament wordt in de VAE niet automatisch erkend voor vastgoed dat zich op VAE-grondgebied bevindt. Een DIFC-testament is in de meeste gevallen nodig om uw VAE eigendom rechtsgeldig te verdelen."
            }
          },
          {
            "@type": "Question",
            "name": "Wat gebeurt er met mijn VAE-vastgoed als ik overlijd zonder testament?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Zonder een geldig testament wordt uw vastgoed doorgaans verdeeld op basis van de Sharia-erfrechtwetgeving. Voor niet-moslims betekent dit dat uw partner doorgaans slechts een beperkt deel ontvangt, in veel gevallen 12,5%, en de rest toekomt aan andere familieleden."
            }
          },
          {
            "@type": "Question",
            "name": "Is een DIFC-testament ingewikkeld om te regelen?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Niet met de juiste begeleiding. Het proces verloopt volledig digitaal via het officiële DIFC-portaal en vereist geen fysieke aanwezigheid in Dubai. De voorbereiding is doorgaans binnen 1 tot 2 weken klaar. De DIFC-afhandeling daarna neemt vervolgens 4 tot 8 weken in beslag."
            }
          },
          {
            "@type": "Question",
            "name": "Wat zijn de totale kosten van een DIFC-testament?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "De totale kosten bestaan uit drie onderdelen: onze servicekosten (€497–€1.499), DIFC-registratiekosten (AED 7.500 enkelvoudig / AED 10.000 mirror will voor Tier 1 en 2; AED 10.000–15.000 voor Tier 3) plus advocaatkosten bij Tier 3. Alle DIFC-tarieven zijn indicatief."
            }
          },
          {
            "@type": "Question",
            "name": "Wat kost een VAE-erfprocedure zonder lokaal testament?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Zonder een lokaal geldig testament moeten uw nabestaanden een volledige VAE-erfprocedure doorlopen. Dit omvat legalisatie, beëdigde Arabische vertalingen en lokale advocaten. De kosten lopen al snel op tot €10.000 of meer, en het proces duurt doorgaans 12 tot 24 maanden."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ik later upgraden als blijkt dat ik een andere tier nodig heb?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. U kunt op elk moment upgraden naar een hogere tier. U betaalt dan alleen het prijsverschil tussen uw huidige tier en de nieuwe tier. Geen verborgen kosten, geen dubbele betaling."
            }
          },
          {
            "@type": "Question",
            "name": "Wat is een mirror will en heb ik er één nodig?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Een mirror will is een gezamenlijke registratie van twee testamenten - voor u en uw partner - in één procedure. Inhoudelijk bepaalt elke partner zelfstandig wie de begunstigden, executeurs en verdeling zijn. Voor stellen met gezamenlijk VAE-vastgoed is dit doorgaans de meest praktische én voordeligste optie."
            }
          },
          {
            "@type": "Question",
            "name": "Kan ik een DIFC-testament regelen als ik niet in Dubai woon?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Ja. De DIFC-testament is toegankelijk voor niet-ingezetenen. Het volledige registratieproces verloopt op afstand via een beveiligd online portaal. U hoeft de VAE niet te bezoeken."
            }
          }
        ]
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  hideNav={true}
  hideFooter={true}
  alternates={{ en: '/' }}
>

  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <a href="#"><img src="/logo-nav.png" alt="VAEtestament" width="148" height="44" style="height:44px;width:auto;display:block;"></a>
      <div style="display:flex;align-items:center;gap:16px;">
        <a href="https://app.vaetestament.nl" class="nav-login" style="color:rgba(255,255,255,0.65);font-size:0.82rem;text-decoration:none;letter-spacing:0.03em;">Inloggen</a>
        <a href="#kennismaking" class="btn btn-gold">Plan gratis gesprek</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-label fade-up">DIFC-testament voor Nederlanders</span>
        <h1 class="fade-up delay-1">
          Uw VAE-vastgoed.<br>
          Zonder <em>jarenlang</em> gedoe voor uw nabestaanden.
        </h1>
        <p class="hero-sub fade-up delay-2">
          Zonder lokaal geldig testament wacht uw familie een VAE-erfprocedure van 12 tot 24 maanden, met legalisatie, beedigde Arabische vertalingen en lokale advocaatkosten die snel oplopen tot &euro;10.000 of meer. Een DIFC-testament voorkomt dit.
        </p>
        <div class="hero-actions fade-up delay-3">
          <a href="#kennismaking" class="btn btn-gold btn-lg">Plan gratis kennismaking</a>
          <a href="#" class="btn btn-outline btn-lg" onclick="openTierCheck();return false;">Vind direct uw passende tier</a>
        </div>
        <p class="hero-note fade-up delay-4">15 minuten &middot; Vrijblijvend &middot; In het Nederlands</p>
      </div>
    </div>
  </section>

  <!-- STAT STRIP -->
  <div class="stat-strip">
    <div class="container">
      <div class="stat-item">
        <span class="stat-num">12&ndash;24 mnd</span>
        <span class="stat-label">Gemiddelde doorlooptijd VAE-erfprocedure zonder lokaal testament</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">&euro;10.000+</span>
        <span class="stat-label">Mogelijke kosten voor legalisatie, vertaling en lokale advocaten</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">Alle emiraten</span>
        <span class="stat-label">Een DIFC-testament geldt voor vastgoed in de hele VAE</span>
      </div>
    </div>
  </div>

  <!-- PROBLEEM -->
  <section class="problem">
    <div class="container">
      <div class="problem-left">
        <p class="section-label">Het probleem</p>
        <h2>Uw Nederlands testament wordt in de VAE doorgaans niet erkend</h2>
        <p class="problem-subtitle">Uw notarieel testament dekt uw VAE-vastgoed doorgaans niet.</p>
        <p>
          U bent Nederlander, woont in Nederland, en heeft vastgoed gekocht in de VAE. Bij overlijden valt dat vastgoed in de regel onder het rechtssysteem van de VAE, niet onder het Nederlandse erfrecht. Een notarieel Nederlands testament wordt door de VAE-autoriteiten doorgaans niet erkend voor vastgoed op VAE-grond. Dat geldt ongeacht of u het bij een Nederlandse notaris heeft laten opstellen of hoe zorgvuldig het is opgesteld.
        </p>
        <p>
          Zonder een lokaal geldig testament moeten uw nabestaanden in veel gevallen een VAE-erfprocedure doorlopen: documenten gelegaliseerd via apostille, beedigde Arabische vertalingen, lokale advocaten ingeschakeld, en maanden wachten voordat het vastgoed overgedragen kan worden. Tijdens die periode kan het pand doorgaans niet vrij verkocht of verhuurd worden.
        </p>
        <p>
          Een DIFC-testament wordt wel erkend door de VAE-autoriteiten en geeft u controle over wie uw vastgoed erft. Het is een aparte juridische structuur, speciaal bedoeld voor niet-moslims met bezittingen in de VAE.
        </p>
      </div>
      <div class="problem-right">
        <span class="big-pct">0%</span>
        <h3>Zo wordt uw Nederlandse testament doorgaans beoordeeld in de VAE.</h3>
        <div class="divider"></div>
        <p>
          De VAE past in de regel lokale erfregels toe op vastgoed binnen haar grenzen, ongeacht uw nationaliteit of woonplaats. Een DIFC-testament wordt wel erkend en geeft u controle over wie uw vastgoed erft.
        </p>
      </div>
    </div>
  </section>

  <!-- OPLOSSING -->
  <section class="solution">
    <div class="container">
      <div class="solution-inner">
        <div>
          <p class="section-label" style="color: var(--gold-light);">De oplossing</p>
          <h2 style="color: var(--white);">Wat is een DIFC-testament, en waarom heeft u er een nodig?</h2>
        </div>
        <div class="solution-text">
          <p>
            Het Dubai International Financial Centre (DIFC) heeft een aparte juridische
            structuur die niet-moslims toestaat een testament te registreren dat
            gebaseerd is op westerse erfrechtnormen. Dit testament is geldig voor
            uw vastgoed in de hele VAE - in Dubai, Abu Dhabi en alle andere emiraten.
          </p>
          <p>
            De registratie verloopt via een officieel online portaal. U hoeft niet
            fysiek in Dubai aanwezig te zijn.
          </p>
          <ul class="solution-bullets">
            <li>Uw eigen verdeling - u bepaalt wie wat erft</li>
            <li>Snelle afhandeling voor uw nabestaanden, geen langdurig erfproces</li>
            <li>Geen onverwachte vertaal- of advocaatkosten voor uw familie</li>
            <li>Geldig voor vastgoed in alle emiraten</li>
            <li>Wijzigbaar zolang u leeft</li>
            <li>Volledig digitaal te regelen vanuit Nederland</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PAKKETTEN -->
  <section class="pakketten" id="pakketten">
    <div class="container">
      <div class="pakketten-header">
        <p class="section-label">Onze diensten</p>
        <h2>Kies de aanpak die bij u past.</h2>
        <p>Drie heldere opties - van volledig zelfstandig tot volledig ontzorgd.
        U betaalt alleen voor wat u nodig heeft.</p>
      </div>

      <div class="cards">

        <!-- Tier 1 -->
        <div class="card">
          <p class="card-tier">Tier 1</p>
          <h3 class="card-name">Zelf &amp; Zeker</h3>
          <p class="card-tagline">Alles wat u nodig heeft om uw DIFC-testament zelf te registreren - op uw eigen tempo.</p>
          <div class="card-divider"></div>
          <div class="card-price">
            <span class="price-amount">&euro;497</span>
            <span class="price-note">Onze vergoeding &middot; DIFC-kosten apart*</span>
          </div>
          <ul class="card-features">
            <li>Toegang tot het VAE Testament-portal - vijf fases, stap voor stap</li>
            <li>Persoonlijke gids door het DIFC-portal, met video's per sectie</li>
            <li>Checklist: welke documenten u nodig heeft, met bestandsnaam-suggesties</li>
            <li>Ondersteuning via het in-portal contactformulier (reactietijd: 2 werkdagen)</li>
            <li>Tot 5 panden per testament</li>
          </ul>
          <div class="card-cta">
            <a href="https://buy.stripe.com/4gM28q9yJcuReIZ4TtbjW02" class="btn btn-outline">Nu beginnen</a>
            <p class="card-cta-secondary"><a href="#kennismaking">Of plan eerst een gratis kennismaking &rarr;</a></p>
          </div>
        </div>

        <!-- Tier 2 (featured) -->
        <div class="card featured">
          <div class="card-badge">Meest gekozen</div>
          <p class="card-tier">Tier 2</p>
          <h3 class="card-name">Samen Registreren</h3>
          <p class="card-tagline">We doorlopen het DIFC-portaal samen in een persoonlijke videosessie van 40 minuten.</p>
          <div class="card-divider"></div>
          <div class="card-price">
            <span class="price-amount">&euro;797</span>
            <span class="price-note">Onze vergoeding &middot; DIFC-kosten apart*</span>
          </div>
          <ul class="card-features">
            <li>Alles uit Tier 1 inbegrepen</li>
            <li>40 minuten begeleide portaalsessie (live video)</li>
            <li>Wij doorlopen de registratie samen, in real time</li>
            <li>WhatsApp-ondersteuning rondom uw sessie</li>
            <li>Tot 5 panden per testament</li>
          </ul>
          <div class="card-cta">
            <a href="https://buy.stripe.com/4gM28q12d1QddEV5XxbjW03" class="btn btn-gold">Nu beginnen</a>
            <p class="card-cta-secondary"><a href="#kennismaking">Of plan eerst een gratis kennismaking &rarr;</a></p>
          </div>
        </div>

        <!-- Tier 3 -->
        <div class="card">
          <p class="card-tier">Tier 3</p>
          <h3 class="card-name">Volledig Ontzorgd</h3>
          <p class="card-tagline">Voor situaties die buiten de standaard DIFC Property Will vallen - bedrijfsstructuren, voogdij, of meer dan 5 panden.</p>
          <div class="card-divider"></div>
          <div class="card-price">
            <span class="price-amount">&euro;1.499</span>
            <span class="price-note">Onze vergoeding &middot; DIFC AED 10.000&ndash;15.000 &middot; Advocaatkosten op offerte*</span>
          </div>
          <ul class="card-features">
            <li>Intake call met Andre + coordinatie van het hele traject</li>
            <li>Introductie bij een gekwalificeerde DIFC-jurist die het juridische maatwerk doet</li>
            <li>WhatsApp-begeleiding gedurende uw volledige traject</li>
            <li>Een inbegrepen aanvullend adviesgesprek van 15 minuten (extra gesprekken &euro;69)</li>
            <li>Voor: bedrijfsbezit, niet-onroerend bezit, voogdij, &gt;5 panden of maatwerk-voorwaarden</li>
          </ul>
          <div class="card-cta">
            <a href="https://buy.stripe.com/8x24gy3al0M91WdclVbjW04" class="btn btn-outline">Nu beginnen</a>
            <p class="card-cta-secondary"><a href="#kennismaking">Of plan eerst een gratis kennismaking &rarr;</a></p>
          </div>
        </div>

      </div>

      <p class="reassurance-note" style="text-align:center; margin-top:24px; font-size:0.88rem; color:var(--mid); font-weight:300; max-width:640px; margin-left:auto; margin-right:auto;">
        Niet zeker welke tier het beste past? U kunt tijdens het proces altijd upgraden naar een hogere tier - u betaalt alleen het verschil. Meer weten? <a href="#kennismaking" style="color:var(--teal); text-decoration:underline;">Plan een gratis kennismaking</a>.
      </p>

      <p class="costs-note">
        * DIFC-registratiekosten voor Tier 1 &amp; 2: <strong>AED 7.500</strong> (enkelvoudig testament) of <strong>AED 10.000</strong> (mirror will) + AED 20 admin. Tier 3: <strong>AED 10.000&ndash;15.000</strong> DIFC-kosten + advocaatkosten <strong>AED 5.000&ndash;10.000</strong> afhankelijk van complexiteit. Alle DIFC-tarieven zijn indicatief en onder voorbehoud van wijziging. Actuele kosten bespreken wij tijdens de kennismaking.
      </p>
    </div>
  </section>

  <!-- HOE WERKT HET -->
  <section class="process">
    <div class="container">
      <div class="process-header">
        <p class="section-label">Hoe werkt het</p>
        <h2>Van kennismaking tot geregistreerde Will</h2>
        <p>Voorbereiding doorgaans 1&ndash;2 weken. DIFC-afhandeling daarna 4&ndash;8 weken.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Gratis gesprek</h3>
          <p>15 minuten. Wij bepalen samen welk pakket bij uw situatie past.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Documenten</h3>
          <p>Wij sturen u een heldere checklist. U verzamelt de benodigde stukken.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Registratie</h3>
          <p>Zelfstandig of samen - uw Will wordt ingediend via het officiele DIFC-portaal.</p>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <h3>Bevestiging</h3>
          <p>U ontvangt de officiele DIFC-registratiebevestiging. Uw erfopvolging is geregeld.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- OVER MIJ -->
  <section class="about">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <p class="section-label">Over de oprichter</p>
          <h2>Waarom VAEtestament?</h2>
          <p>
            Ik ben Andre van Wijngaarden - oprichter van VAEtestament en voormalig
            Head of Investor Services in de VAE-vastgoedsector. Met een achtergrond in
            International Business en commerciele ervaring in meerdere landen sprak ik
            met tal van Nederlandse investeerders die VAE-vastgoed kochten als
            investering of als anker voor hun internationale levensstijl.
          </p>
          <p>
            Wat mij bleef opvallen: vrijwel niemand wist van de Sharia-erfrechtsituatie.
            Niet bij aankoop, niet daarna. VAEtestament bestaat om dat gat te dichten -
            met heldere informatie en directe ondersteuning bij de DIFC-registratie.
          </p>
          <p>
            Voor situaties die juridische expertise vereisen, verwijzen wij u door naar
            ervaren DIFC-advocaten uit ons netwerk. Zo heeft u altijd de juiste
            begeleiding voor uw specifieke situatie.
          </p>
          <div class="credentials">
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Voormalig Head of Investor Services, VAE-vastgoedsector</strong>
                Tal van Nederlandse vastgoedinvesteerders begeleid in de VAE
              </div>
            </div>
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Netwerk van ervaren DIFC-advocaten</strong>
                Voor complexe situaties verwijzen wij u door naar de juiste specialist
              </div>
            </div>
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Specialist voor Nederlandse niet-ingezetenen</strong>
                Wij begrijpen uw situatie - u woont in Nederland en belegt in de VAE
              </div>
            </div>
          </div>
        </div>
        <div class="about-visual">
          <div style="margin-bottom:24px; text-align:center;">
            <img src="/andre-photo.jpg"
              alt="Andre van Wijngaarden"
              width="180" height="180" loading="lazy"
              style="width:180px; height:180px; object-fit:cover; object-position:center top; border-radius:50%; border:3px solid rgba(200,164,74,0.4); display:inline-block;">
          </div>
          <div class="about-card" style="margin-top:0;">
            <blockquote>
              "De meeste Nederlandse investeerders realiseren zich pas achteraf hoe kwetsbaar
              hun situatie was. Het regelen van een DIFC-testament kost een paar uur -
              het nalaten ervan kan uw erfgenamen jaren kosten."
            </blockquote>
            <cite>
              <strong>Andre van Wijngaarden</strong> - Oprichter VAEtestament
            </cite>
          </div>
        </div>
      </div>
    </div>
