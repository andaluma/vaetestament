---
import BaseLayout from '../../layouts/BaseLayout.astro';

const siteRoot = 'https://uaepropertywills.com';
const title = 'UAEpropertyWills - DIFC will for foreign property owners in the UAE';
const description = 'Protect your UAE property with a DIFC will. For foreign non-residents. Three clear options, transparent pricing.';
const canonical = `${siteRoot}/`;
const ogImage = `${siteRoot}/og-default-en.png`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteRoot}/#organization`,
    "name": "UAEpropertyWills",
    "legalName": "Andaluma OÜ",
    "url": siteRoot + "/",
    "logo": siteRoot + "/logo-nav-en.svg",
    "description": "DIFC will guidance service for foreign property owners in the UAE. Protect your succession with a legally valid will.",
    "founder": {
      "@type": "Person",
      "name": "André van Wijngaarden",
      "url": siteRoot + "/about/"
    },
    "areaServed": ["AE"],
    "inLanguage": "en",
    "contactPoint": {
      "@type": "ContactPoint",
      "email": "info@uaepropertywills.com",
      "telephone": "+31616146007",
      "contactType": "customer support",
      "availableLanguage": ["en", "nl", "es"]
    },
    "sameAs": ["https://www.linkedin.com/in/adriaanvanwijngaarden"]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteRoot}/#website`,
    "url": siteRoot + "/",
    "name": "UAEpropertyWills",
    "inLanguage": "en",
    "publisher": { "@id": `${siteRoot}/#organization` }
  },
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "ProfessionalService",
        "name": "UAEpropertyWills",
        "url": siteRoot,
        "description": "DIFC will guidance for foreign owners of UAE property. Protect your succession with a legally registered will in the UAE.",
        "founder": {
          "@type": "Person",
          "name": "André van Wijngaarden"
        },
        "areaServed": {
          "@type": "Place",
          "name": "United Arab Emirates"
        },
        "serviceType": "DIFC will registration guidance",
        "offers": [
          {
            "@type": "Offer",
            "name": "Guided Registration",
            "price": "797",
            "priceCurrency": "EUR",
            "description": "40-minute guided portal session for DIFC will registration"
          },
          {
            "@type": "Offer",
            "name": "Fully Managed",
            "price": "1499",
            "priceCurrency": "EUR",
            "description": "Fully guided DIFC will registration including referral to a certified lawyer"
          }
        ],
        "sameAs": [
          "https://cal.com/vaetestament.nl/15min"
        ]
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Does Sharia law apply to me as a non-Muslim?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "In many cases, yes. The UAE generally applies local inheritance law to assets within its territory upon death, regardless of your nationality or religion. For non-Muslims, this may mean that the default regime based on Sharia applies. Since 1 January 2026, Federal Decree-Law No. 51 of 2024 adds a further consequence: assets of deceased persons without identifiable heirs are permanently transferred to a state-managed Waqf foundation. A DIFC will allows non-Muslims to deviate from all of this through a legally registered will."
            }
          },
          {
            "@type": "Question",
            "name": "Does my home-country will also cover my UAE property?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Generally not. A home-country will is not automatically recognised in the UAE for property on UAE soil. A DIFC will is in most cases required to legally distribute your UAE property."
            }
          },
          {
            "@type": "Question",
            "name": "What happens to my UAE property if I pass away without a will?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Without a valid will, your property is typically distributed based on applicable inheritance law. For non-Muslims, this may mean that your partner receives a limited share, and the remainder goes to other family members. For owners without identifiable heirs, Federal Decree-Law No. 51 of 2024 means the assets may be permanently transferred to a state-managed Waqf foundation."
            }
          },
          {
            "@type": "Question",
            "name": "Is a DIFC will complicated to arrange?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Not with the right guidance. The process is fully digital via the official DIFC portal and requires no physical presence in Dubai. Preparation is typically completed within 1 to 2 weeks. The DIFC processing afterwards takes 4 to 8 weeks."
            }
          },
          {
            "@type": "Question",
            "name": "What are the total costs of a DIFC will?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Total costs consist of three components: our guidance fee (€797 or €1,499), DIFC registration fees (paid directly to the DIFC), plus lawyer fees for Tier 3. All DIFC rates are indicative."
            }
          },
          {
            "@type": "Question",
            "name": "What does a UAE probate procedure cost without a local will?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Without a locally valid will, your surviving family must go through a full UAE probate procedure. This involves legalisation, sworn Arabic translations and local lawyers. Costs quickly reach €10,000 or more, and the process typically takes 12 to 24 months."
            }
          },
          {
            "@type": "Question",
            "name": "Can I upgrade later if I need a different tier?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. You can upgrade to a higher tier at any time. You only pay the price difference. No hidden costs, no double payment."
            }
          },
          {
            "@type": "Question",
            "name": "What is a mirror will and do I need one?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "A mirror will is a joint registration of two wills, for you and your partner, in one procedure. Each partner independently determines the beneficiaries, executors and distribution. For couples with joint UAE property, this is typically the most practical and cost-effective option."
            }
          },
          {
            "@type": "Question",
            "name": "Can I arrange a DIFC will if I do not live in Dubai?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. The DIFC will is available to non-residents. The entire registration process is conducted remotely via a secure online portal. You do not need to visit the UAE."
            }
          }
        ]
      }
    ]
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  jsonLd={jsonLd}
  hideNav={true}
  hideFooter={true}
  locale="en"
  alternates={{ nl: '/' }}
>

  <!-- NAV -->
  <nav>
    <div class="nav-inner">
      <a href="/"><img src="/logo-nav-en.svg" alt="UAEpropertyWills" width="230" height="68" style="height:68px;width:auto;display:block;"></a>
      <div style="display:flex;align-items:center;gap:16px;">
        <a href="https://app.uaepropertywills.com" class="nav-login" style="color:rgba(255,255,255,0.65);font-size:0.82rem;text-decoration:none;letter-spacing:0.03em;">Log in</a>
        <a href="#consultation" class="btn btn-gold">Schedule free call</a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <span class="hero-label fade-up">DIFC will for foreign property owners</span>
        <h1 class="fade-up delay-1">
          We do one thing: DIFC Property Wills<br>
          for foreign non-resident property owners.
        </h1>
        <p class="hero-sub fade-up delay-2">
          For most property owners, a Property Will is sufficient, not a Full Will. We tell you honestly whether that applies to you.
        </p>
        <div class="hero-actions fade-up delay-3">
          <a href="#consultation" class="btn btn-gold btn-lg">Schedule free consultation</a>
          <a href="#" class="btn btn-outline btn-lg" onclick="openTierCheck();return false;">Find your tier now</a>
        </div>
        <p class="hero-note fade-up delay-4">15 minutes &middot; No obligation</p>
      </div>
    </div>
  </section>

  <!-- STAT STRIP -->
  <div class="stat-strip">
    <div class="container">
      <div class="stat-item">
        <span class="stat-num">12&ndash;24 months</span>
        <span class="stat-label">Average duration of a UAE probate procedure without a local will</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">&euro;10,000+</span>
        <span class="stat-label">Potential costs for legalisation, translation and local lawyers</span>
      </div>
      <div class="stat-item">
        <span class="stat-num">All Emirates</span>
        <span class="stat-label">A DIFC will covers property across the entire UAE</span>
      </div>
    </div>
  </div>

  <!-- PROBLEM -->
  <section class="problem">
    <div class="container">
      <div class="problem-left">
        <p class="section-label">The problem</p>
        <h2>Your home-country will is generally not recognised in the UAE</h2>
        <p class="problem-subtitle">Your existing will typically does not cover your UAE property.</p>
        <p>
          You live abroad, and you own property in the UAE. Upon death, that property falls under the UAE legal system, not under the inheritance law of your home country. A will drafted at home is generally not recognised by the UAE authorities for property on UAE soil. This applies regardless of how carefully it was prepared.
        </p>
        <p>
          Without a locally valid will, your surviving family must in many cases go through a UAE probate procedure: documents legalised via apostille, sworn Arabic translations, local lawyers engaged, and months of waiting before the property can be transferred. During that period, the property generally cannot be freely sold or rented. Since 1 January 2026, Federal Decree-Law No. 51 of 2024 adds a further consequence: assets of deceased persons without identifiable heirs are permanently transferred to a state-managed Waqf foundation.
        </p>
        <p>
          A DIFC will is recognised by the UAE authorities and gives you control over who inherits your property. It is a separate legal structure, specifically designed for non-Muslims with assets in the UAE.
        </p>
      </div>
      <div class="problem-right">
        <span class="big-pct">0%</span>
        <h3>This is how your home-country will is typically assessed in the UAE.</h3>
        <div class="divider"></div>
        <p>
          The UAE generally applies local inheritance rules to property within its borders, regardless of your nationality or place of residence. A DIFC will is recognised and gives you control over who inherits your property.
        </p>
      </div>
    </div>
  </section>

  <!-- SOLUTION -->
  <section class="solution">
    <div class="container">
      <div class="solution-inner">
        <div>
          <p class="section-label" style="color: var(--gold-light);">The solution</p>
          <h2 style="color: var(--white);">What is a DIFC will, and why do you need one?</h2>
        </div>
        <div class="solution-text">
          <p>
            The Dubai International Financial Centre (DIFC) has a separate legal
            structure that allows non-Muslims to register a will based on Western
            succession principles. This will is valid for your property across the
            entire UAE, in Dubai, Abu Dhabi and all other Emirates.
          </p>
          <p>
            Registration takes place via an official online portal. You do not
            need to be physically present in Dubai.
          </p>
          <ul class="solution-bullets">
            <li>Your own distribution - you decide who inherits what</li>
            <li>Fast settlement for your family, no lengthy succession process</li>
            <li>No unexpected translation or lawyer costs for your family</li>
            <li>Valid for property in all Emirates</li>
            <li>Can be amended as long as you live</li>
            <li>Fully digital, arranged from wherever you are</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="pakketten" id="packages">
    <div class="container">
      <div class="pakketten-header">
        <p class="section-label">Our services</p>
        <h2>Choose the approach that suits you.</h2>
        <p>Two clear options - from guided to fully managed.
        You pay only for what you need.</p>
      </div>

      <div class="cards cards-2col">

        <!-- Tier 2 (featured) -->
        <div class="card featured">
          <div class="card-badge">Most chosen</div>
          <p class="card-tier">Tier 2</p>
          <h3 class="card-name">Guided Registration</h3>
          <p class="card-tagline">We walk through the DIFC portal together in a personal 40-minute video session.</p>
          <div class="card-divider"></div>
          <div class="card-price">
            <span class="price-amount">&euro;797</span>
            <span class="price-note">Our guidance fee &middot; DIFC costs separate*</span>
          </div>
          <ul class="card-features">
            <li>Structured preparation with videos and checklists</li>
            <li>40-minute guided portal session (live video)</li>
            <li>We walk through the registration together, in real time</li>
            <li>WhatsApp support around your session</li>
            <li>Up to 5 properties per will</li>
          </ul>
          <div class="card-cta">
            <a href="https://buy.stripe.com/4gM28q12d1QddEV5XxbjW03" class="btn btn-gold">Get started</a>
            <p class="card-cta-secondary"><a href="#consultation">Or schedule a free consultation first &rarr;</a></p>
          </div>
        </div>

        <!-- Tier 3 -->
        <div class="card">
          <p class="card-tier">Tier 3</p>
          <h3 class="card-name">Fully Managed</h3>
          <p class="card-tagline">For situations beyond the standard DIFC Property Will: corporate structures, guardianship, or more than 5 properties.</p>
          <div class="card-divider"></div>
          <div class="card-price">
            <span class="price-amount">&euro;1,499</span>
            <span class="price-note">Our guidance fee &middot; DIFC AED 10,000&ndash;15,000 &middot; Lawyer fees quoted separately*</span>
          </div>
          <ul class="card-features">
            <li>Intake call with Andr&eacute; + coordination of the entire process</li>
            <li>Referral to a qualified DIFC lawyer for the legal work</li>
            <li>WhatsApp support throughout your entire process</li>
            <li>One included 15-minute advisory session (additional sessions &euro;69)</li>
            <li>For: corporate ownership, non-real estate assets, guardianship, &gt;5 properties or bespoke provisions</li>
          </ul>
          <div class="card-cta">
            <a href="https://buy.stripe.com/8x24gy3al0M91WdclVbjW04" class="btn btn-outline">Get started</a>
            <p class="card-cta-secondary"><a href="#consultation">Or schedule a free consultation first &rarr;</a></p>
          </div>
        </div>

      </div>

      <p class="reassurance-note" style="text-align:center; margin-top:24px; font-size:0.88rem; color:var(--mid); font-weight:300; max-width:640px; margin-left:auto; margin-right:auto;">
        Not sure which tier fits best? You can always upgrade to a higher tier during the process - you only pay the difference. Want to know more? <a href="#consultation" style="color:var(--teal); text-decoration:underline;">Schedule a free consultation</a>.
      </p>

      <p class="costs-note">
        * DIFC registration fees for Tier 2: <strong>AED 7,500</strong> (single will) or <strong>AED 10,000</strong> (mirror will) + AED 20 admin. Tier 3: <strong>AED 10,000&ndash;15,000</strong> DIFC fees + lawyer fees <strong>AED 5,000&ndash;10,000</strong> depending on complexity. All DIFC rates are indicative and subject to change. Current costs are discussed during the consultation.
      </p>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="process">
    <div class="container">
      <div class="process-header">
        <p class="section-label">How it works</p>
        <h2>From consultation to registered will</h2>
        <p>Preparation typically 1&ndash;2 weeks. DIFC processing afterwards 4&ndash;8 weeks.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="step-num">1</div>
          <h3>Free consultation</h3>
          <p>15 minutes. We determine together which package suits your situation.</p>
        </div>
        <div class="step">
          <div class="step-num">2</div>
          <h3>Documents</h3>
          <p>We send you a clear checklist. You gather the required documents.</p>
        </div>
        <div class="step">
          <div class="step-num">3</div>
          <h3>Registration</h3>
          <p>Self-guided or together - your will is submitted via the official DIFC portal.</p>
        </div>
        <div class="step">
          <div class="step-num">4</div>
          <h3>Confirmation</h3>
          <p>You receive the official DIFC registration confirmation. Your succession is arranged.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="about">
    <div class="container">
      <div class="about-inner">
        <div class="about-text">
          <p class="section-label">Your guide</p>
          <h2>Why UAEpropertyWills?</h2>
          <p>
            I am Andr&eacute; van Wijngaarden, founder of UAEpropertyWills and former
            Head of Investor Services in the UAE real estate sector. With a background in
            International Business and commercial experience across multiple countries, I have
            spoken with numerous foreign investors who purchased UAE property as
            an investment or as an anchor for their international lifestyle.
          </p>
          <p>
            What kept striking me: virtually no one was aware of the inheritance law situation.
            Not at the time of purchase, not afterwards. UAEpropertyWills exists to bridge that gap -
            with clear information and direct support for the DIFC registration process.
          </p>
          <p>
            For situations that require legal expertise, we refer you to
            experienced DIFC lawyers from our network. This way you always have the right
            guidance for your specific situation.
          </p>
          <div class="credentials">
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Former Head of Investor Services, UAE real estate sector</strong>
                Guided numerous foreign property investors in the UAE
              </div>
            </div>
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Network of experienced DIFC lawyers</strong>
                For complex situations we refer you to the right specialist
              </div>
            </div>
            <div class="cred-item">
              <div class="cred-icon">&#10022;</div>
              <div class="cred-text">
                <strong>Specialist for foreign non-residents</strong>
                We understand your situation - you live abroad and invest in the UAE
              </div>
            </div>
          </div>
        </div>
        <div class="about-visual">
          <div style="margin-bottom:24px; text-align:center;">
            <img src="/andre-photo.jpg"
              alt="Andre van Wijngaarden"
              width="180" height="180" loading="lazy"
              style="width:180px; height:180px; object-fit:cover; object-position:center top; border-radius:50%; border:3px solid rgba(200,164,74,0.4); display:inline-block;">
          </div>
          <div class="about-card" style="margin-top:0;">
            <blockquote>
              "Most foreign investors only realise afterwards how vulnerable
              their situation was. Arranging a DIFC will takes a few hours -
              failing to do so can cost your heirs years."
            </blockquote>
            <cite>
              <strong>Andr&eacute; van Wijngaarden</strong> - Founder UAEpropertyWills
            </cite>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROPERTY WILL VS FULL WILL -->
  <section class="pw-vs-fw" style="background:var(--cream-dark);padding:80px 0;">
    <div class="container" style="max-width:var(--max-prose);">
      <p class="section-label" style="text-align:center;">The key question</p>
      <h2 style="font-family:var(--font-display);font-size:2rem;text-align:center;margin-bottom:2rem;color:var(--teal);">Do you need a Property Will or a Full Will?</h2>
      <p style="margin-bottom:1.25rem;line-height:1.8;">Many foreign property owners in the UAE pay for a Full Will when a Property Will would suffice. The difference? A Property Will covers your real estate. A Full Will covers everything, including bank accounts, vehicles and guardianship.</p>
      <p style="margin-bottom:1.25rem;line-height:1.8;">If you only own property in your personal name, without minor children in the UAE and without corporate structures, a Property Will is almost always the right choice.</p>
      <p style="margin-bottom:2rem;line-height:1.8;">We help you make that assessment. No sales pitch, no upsell. If a Property Will is sufficient, we say so. If you need a Full Will, we explain why.</p>
      <div style="text-align:center;display:flex;flex-direction:column;align-items:center;gap:0.75rem;">
        <a href="#" class="btn btn-gold btn-lg" onclick="openTierCheck();return false;">Take the test: which will fits your situation?</a>
        <a href="/beslissingsgids/" style="font-size:0.9rem;color:var(--teal);text-decoration:underline;">Or download our free decision guide</a>
      </div>
    </div>
  </section>

  <!-- PORTAL ACKNOWLEDGMENT -->
  <section style="background:var(--teal-mid);padding:48px 0;">
    <div class="container" style="max-width:var(--max-prose);text-align:center;">
      <p style="color:rgba(255,255,255,0.9);font-style:italic;line-height:1.8;font-size:1.05rem;">Yes, the DIFC portal exists. This is what doing it yourself looks like in practice: English legal terminology, decisions you must make without context, weeks of research, and no one to call when you get stuck. We make that process accessible.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq">
    <div class="container">
      <div class="faq-header">
        <p class="section-label">Frequently asked questions</p>
        <h2>Answers to your questions.</h2>
        <p>Everything you need to know before making a decision. For detailed explanations per topic: <a href="/articles/" style="color:var(--teal);text-decoration:underline;">view our articles &rarr;</a></p>
      </div>
      <div class="faq-list">

        <div class="faq-item">
          <button class="faq-question">
            Does Sharia law apply to me as a non-Muslim?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            In many cases, yes. The UAE generally applies local inheritance law to assets within its territory upon death, regardless of your nationality or religion. For non-Muslims, this may mean that the default regime based on Sharia applies, which can lead to a distribution that does not match your wishes. Since 1 January 2026, Federal Decree-Law No. 51 of 2024 adds a further consequence: assets of deceased persons without identifiable heirs are permanently transferred to a state-managed charitable foundation (Waqf). A DIFC will allows non-Muslims to deviate from all of this through a legally registered will.
            <p style="margin-top:0.75rem;"><a href="/articles/uae-inheritance-law-foreign-owners/" style="color:var(--teal);font-weight:500;">Read more: UAE inheritance law for foreign owners &rarr;</a></p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            Does my home-country will also cover my UAE property?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            Generally not. A home-country will is not automatically recognised in the UAE for property on UAE soil. A separate, locally registered document - such as a DIFC will - is in most cases required to legally distribute your UAE property. We always recommend consulting a legal adviser for your specific situation.
            <p style="margin-top:0.75rem;"><a href="/articles/difc-will-vs-home-country-will/" style="color:var(--teal);font-weight:500;">Read more about combining two wills &rarr;</a></p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            What happens to my UAE property if I pass away without a will?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            Without a valid will in the UAE, your property is typically distributed based on applicable inheritance law. For non-Muslims, this may mean that your partner receives only a limited share, and the remainder goes to other family members, regardless of your personal wishes. The exact distribution depends on your family situation. For owners without identifiable heirs (single owners, or those with an unmarried partner), Federal Decree-Law No. 51 of 2024 means the assets may be permanently transferred to a state-managed Waqf foundation.
            <p style="margin-top:0.75rem;"><a href="/articles/dubai-property-without-will/" style="color:var(--teal);font-weight:500;">Read more: What happens without a will &rarr;</a></p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            Is a DIFC will complicated to arrange?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
            Not with the right guidance. The process is fully digital via the official DIFC portal and requires no physical presence in Dubai. Preparation (gathering data, preparing documents, portal registration) is typically completed within 1 to 2 weeks. The DIFC processing afterwards - appointment, signing and official registration - takes 4 to 8 weeks.
            <p style="margin-top:0.75rem;"><a href="/articles/register-difc-will-from-abroad/" style="color:var(--teal);font-weight:500;">Read more: Registering a DIFC will step by step &rarr;</a></p>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question">
            What is a mirror will and do I need one?
            <span class="faq-icon">+</span>
          </button>
          <div class="faq-answer">
