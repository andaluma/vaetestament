---
// SiteNav - fixed teal navigation, matches the live homepage exactly.
// Renders on every Astro-built page via BaseLayout (opt-out via prop).

interface Props { locale?: 'nl' | 'en' | 'es'; }
const { locale = 'nl' } = Astro.props;

const NAV_STRINGS: Record<string, { articles: string; articlesHref: string; login: string; loginHref: string; cta: string; ctaHref: string }> = {
  nl: { articles: 'Artikelen', articlesHref: '/artikelen/', login: 'Inloggen', loginHref: 'https://app.vaetestament.nl', cta: 'Plan gratis gesprek', ctaHref: '/#kennismaking' },
  en: { articles: 'Articles', articlesHref: '/articles/', login: 'Log in', loginHref: 'https://app.uaepropertywills.com', cta: 'Schedule free call', ctaHref: '/#consultation' },
  es: { articles: 'Artículos', articlesHref: '/articulos/', login: 'Iniciar sesión', loginHref: 'https://app.vaetestament.nl', cta: 'Reservar llamada', ctaHref: '/#consulta' },
};
const t = NAV_STRINGS[locale] || NAV_STRINGS.nl;
---

<nav class="site-nav">
  <div class="nav-inner">
    <a href="/" class="site-logo" aria-label={locale === 'en' ? 'UAEpropertyWills home' : 'VAEtestament home'}>{locale === 'en' ? <Fragment>UAE<span>propertyWills</span></Fragment> : <Fragment>VAE<span>testament</span></Fragment>}</a>
    <div class="nav-actions">
      <a href={t.articlesHref} class="nav-link">{t.articles}</a>
      <a href={t.loginHref} class="nav-link nav-link--muted">{t.login}</a>
      <a href={t.ctaHref} class="nav-cta">{t.cta}</a>
    </div>
  </div>
</nav>

<style is:global>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(12, 74, 69, 0.97);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(200, 164, 74, 0.18);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 32px;
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-logo {
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: 0.01em;
    text-decoration: none;
  }
  .site-logo span { color: var(--gold); }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .nav-link {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.88rem;
    font-weight: 400;
    text-decoration: none;
    letter-spacing: 0.03em;
    transition: color 0.15s;
  }
  .nav-link:hover { color: var(--gold-light); }
  .nav-link--muted { color: rgba(255, 255, 255, 0.55); }
  .nav-cta {
    display: inline-block;
    padding: 9px 20px;
    background: var(--gold);
    color: var(--dark);
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s, transform 0.2s;
  }
  .nav-cta:hover { background: var(--gold-light); transform: translateY(-1px); }
  @media (max-width: 640px) {
    .nav-inner { padding: 0 20px; height: 60px; }
    .nav-link { display: none; }
    .site-logo { font-size: 1.3rem; }
    .nav-cta { padding: 8px 14px; font-size: 0.8rem; }
  }
</style>
