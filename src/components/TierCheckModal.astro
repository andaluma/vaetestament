---
// TierCheckModal - "Property Will of Full Will?" decision tool
// 5 questions → Property Will (T1/T2) or Full Will (T3)
// i18n NL/EN. EN hides T1.
//
// Inclusion: BaseLayout renders <TierCheckModal /> once per page.
// Any page can call window.openTierCheck(slug?) to launch.
//
// Stripe links are locked here. If a link rotates, also update
// phase4-renderer/phase4.js in the platform repo.
---

<div class="tc-overlay" id="tcOverlay" role="dialog" aria-modal="true" aria-labelledby="tcTitle">
  <div class="tc-modal">
    <button class="tc-close" type="button" id="tcClose" aria-label="Sluiten">&times;</button>

    <div class="tc-progress" id="tcProgress">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="tc-step active" data-step="0">
      <h3 id="tcTitle"></h3>
      <p></p>
      <div class="tc-options">
        <button class="tc-opt" type="button" data-q="0" data-v="1"></button>
        <button class="tc-opt" type="button" data-q="0" data-v="2-5"></button>
        <button class="tc-opt" type="button" data-q="0" data-v="5+"></button>
      </div>
    </div>

    <div class="tc-step" data-step="1">
      <h3></h3>
      <p></p>
      <div class="tc-options">
        <button class="tc-opt" type="button" data-q="1" data-v="personal"></button>
        <button class="tc-opt" type="button" data-q="1" data-v="corporate"></button>
      </div>
    </div>

    <div class="tc-step" data-step="2">
      <h3></h3>
      <p></p>
      <div class="tc-options">
        <button class="tc-opt" type="button" data-q="2" data-v="nee"></button>
        <button class="tc-opt" type="button" data-q="2" data-v="ja"></button>
      </div>
    </div>

    <div class="tc-step" data-step="3">
      <h3></h3>
      <p></p>
      <div class="tc-options">
        <button class="tc-opt" type="button" data-q="3" data-v="nee"></button>
        <button class="tc-opt" type="button" data-q="3" data-v="ja"></button>
      </div>
    </div>

    <div class="tc-step" data-step="4">
      <h3></h3>
      <p></p>
      <div class="tc-options">
        <button class="tc-opt" type="button" data-q="4" data-v="ja"></button>
        <button class="tc-opt" type="button" data-q="4" data-v="nee"></button>
      </div>
    </div>

    <div class="tc-result" id="tcResult">
      <div class="tc-result-card" id="tcResultCard">
        <span class="tc-result-badge" id="tcBadge"></span>
        <h3 id="tcResultHeading"></h3>
        <p id="tcResultDesc"></p>
        <p class="tc-dutch-note" id="tcDutchNote"></p>
      </div>
      <div id="tcTierBtns" class="tc-tier-btns"></div>
      <p class="tc-price-note" id="tcPriceNote"></p>
      <a class="tc-consult" id="tcConsultLink" href="https://cal.com/vaetestament.nl/15min" target="_blank" rel="noopener"></a>

      <div class="tc-newsletter">
        <p class="tc-newsletter-label" id="tcNLLabel"></p>
        <p class="tc-newsletter-body" id="tcNLBody"></p>
        <form class="nl-form tc-newsletter-form" data-slug="tier-check" novalidate>
          <label class="nl-honeypot" aria-hidden="true">Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          <input type="email" name="email" required autocomplete="email" id="tcNLEmail" />
          <button type="submit" id="tcNLSubmit"></button>
          <p class="nl-status" role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .tc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }
  .tc-overlay.open { display: flex; }
  .tc-modal {
    background: #fff;
    border-radius: 16px;
    max-width: 520px;
    width: 92%;
    max-height: 90vh;
    overflow-y: auto;
    padding: 40px 36px 32px;
    position: relative;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);
  }
  .tc-close {
    position: absolute;
    top: 16px;
    right: 20px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
    color: var(--muted);
    line-height: 1;
  }
  .tc-close:hover { color: var(--teal); }
  .tc-progress {
    display: flex;
    gap: 6px;
    margin-bottom: 28px;
  }
  .tc-progress span {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: #e0e0e0;
    transition: background 0.3s;
  }
  .tc-progress span.done { background: var(--teal); }
  .tc-step { display: none; }
  .tc-step.active { display: block; }
  .tc-step h3 {
    font-size: 1.15rem;
    margin-bottom: 6px;
    color: var(--ink);
    font-family: var(--font-body);
  }
  .tc-step p {
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .tc-options { display: flex; flex-direction: column; gap: 10px; }
  .tc-opt {
    display: block;
    width: 100%;
    text-align: left;
    padding: 14px 18px;
    border: 2px solid #e0e0e0;
    border-radius: 10px;
    background: #fff;
    font-size: 0.95rem;
    font-family: var(--font-body);
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .tc-opt:hover { border-color: var(--teal); background: #fafafa; }
  .tc-opt.selected { border-color: var(--teal); background: var(--cream); }

  .tc-result { display: none; text-align: center; padding: 20px 0 0; }
  .tc-result.active { display: block; }
  .tc-result-card {
    background: var(--cream);
    border-radius: 12px;
    padding: 28px 24px;
    margin-bottom: 20px;
  }
  .tc-result-badge {
    display: inline-block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 3px;
    margin-bottom: 12px;
  }
  .tc-result-card.tc-pw .tc-result-badge {
    background: var(--teal);
    color: #fff;
  }
  .tc-result-card.tc-fw .tc-result-badge {
    background: var(--gold);
    color: #fff;
  }
  .tc-result-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--ink);
    margin-bottom: 8px;
  }
  .tc-result-card p {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .tc-dutch-note {
    font-size: 0.82rem;
    color: var(--teal);
    font-style: italic;
    margin-top: 8px;
  }
  .tc-dutch-note:empty { display: none; }

  .tc-tier-btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  .tc-tier-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s, box-shadow 0.15s;
    cursor: pointer;
  }
  .tc-tier-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(0,0,0,0.1);
  }
  .tc-tier-btn-outline {
    background: #fff;
    border: 2px solid var(--teal);
    color: var(--teal);
  }
  .tc-tier-btn-gold {
    background: var(--teal);
    border: 2px solid var(--teal);
    color: #fff;
  }
  .tc-tier-btn-left {
    text-align: left;
  }
  .tc-tier-btn-name {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
    font-family: var(--font-body);
  }
  .tc-tier-btn-desc {
    display: block;
    font-size: 0.78rem;
    opacity: 0.7;
    margin-top: 2px;
  }
  .tc-tier-btn-price {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 600;
    white-space: nowrap;
    margin-left: 16px;
  }
  .tc-tier-btn-gold .tc-tier-btn-price { color: var(--gold); }

  .tc-price-note {
    font-size: 0.75rem;
    color: var(--muted);
    margin-bottom: 16px;
    font-style: italic;
  }

  .tc-consult {
    display: block;
    font-size: 0.92rem;
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-bottom: 8px;
  }
  .tc-consult:hover { color: var(--teal-mid); }

  .tc-newsletter {
    margin-top: 20px;
    padding-top: 18px;
    border-top: 1px solid var(--cream-dark);
    text-align: left;
  }
  .tc-newsletter-label {
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 500;
    margin: 0 0 6px;
  }
  .tc-newsletter-body {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0 0 12px;
    line-height: 1.55;
  }
  .tc-newsletter-form {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
  }
  .tc-newsletter-form input[type="email"] {
    flex: 1 1 180px;
    min-width: 0;
    padding: 10px 12px;
    font-family: var(--font-body);
    font-size: 0.92rem;
    border: 1px solid var(--cream-dark);
    border-radius: 3px;
    background: var(--cream);
  }
  .tc-newsletter-form input[type="email"]:focus {
    outline: 2px solid var(--gold);
    outline-offset: 1px;
    background: #fff;
  }
  .tc-newsletter-form button {
    padding: 10px 18px;
    background: var(--teal);
    color: #fff;
    border: none;
    border-radius: 3px;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: background 0.15s;
  }
  .tc-newsletter-form button:hover { background: var(--teal-mid); }
  .tc-newsletter-form button:disabled { opacity: 0.6; cursor: wait; }
  .tc-newsletter-form .nl-status {
    width: 100%;
    margin: 6px 0 0;
    font-size: 0.85rem;
  }
  .tc-newsletter-form .nl-status.ok { color: var(--teal); }
  .tc-newsletter-form .nl-status.err { color: #B33A3A; }

  @media (max-width: 600px) {
    .tc-modal { padding: 28px 20px 24px; }
  }
</style>

<script is:inline>
  (function () {
    if (window.__tcInit) return;
    window.__tcInit = true;

    var answers = [];
    var step = 0;
    var totalSteps = 5;
    var sourceSlug = null;
    var locale = 'nl';

    var links = {
      nl: {
        t1: 'https://buy.stripe.com/bJe7sD8tma2R9s2d6Z0Jq00',
        t2: 'https://buy.stripe.com/dRmfZ9eRK0sh0Vw8QJ0Jq02',
        t3: 'https://buy.stripe.com/fZu5kvfVOdf37jU8QJ0Jq04'
      },
      en: {
        t1: 'https://buy.stripe.com/bJe7sDbFy2Ap6fQc2V0Jq01',
        t2: 'https://buy.stripe.com/dRmdR15ha7UJgUud6Z0Jq03',
        t3: 'https://buy.stripe.com/5kQdR19xqcaZ6fQ6IB0Jq05'
      }
    };

    var S = {
      nl: {
        q: [
          ['Hoeveel panden in de VAE wilt u opnemen?', 'Tel alle appartementen, villa\'s en andere vastgoedobjecten.', ['1 pand', '2 t/m 5 panden', 'Meer dan 5 panden']],
          ['Staat het vastgoed op uw persoonlijke naam?', 'Of op naam van een BV, holding, free zone company of andere rechtspersoon?', ['Ja, op mijn persoonlijke naam', 'Nee, via een bedrijf of holding']],
          ['Wilt u ook andere VAE-bezittingen opnemen?', 'Bijvoorbeeld bankrekeningen, beleggingen of voertuigen in de VAE.', ['Nee, alleen vastgoed', 'Ja, ook andere bezittingen']],
          ['Heeft u minderjarige kinderen waarvoor u voogdij wilt regelen?', 'Een voogdijbepaling kan alleen via een Full Will worden vastgelegd.', ['Nee', 'Ja, ik wil voogdij regelen']],
          ['Heeft u al een Nederlands testament?', 'Dit heeft geen invloed op uw DIFC-testament, maar helpt ons bij het advies.', ['Ja, ik heb een Nederlands testament', 'Nee, ik heb geen Nederlands testament']]
        ],
        pwBadge: 'Property Will',
        pwTitle: 'Een Property Will dekt uw situatie.',
        pwDesc: 'Uw vastgoed staat op persoonlijke naam, zonder bedrijfsstructuren, voogdij of niet-onroerend bezit. Een DIFC Property Will is de juiste keuze.',
        pwDutchYes: 'Uw DIFC-testament werkt aanvullend op uw bestaande Nederlandse testament.',
        pwDutchNo: 'Tip: overweeg ook een Nederlands testament voor uw bezittingen in Nederland.',
        fwBadge: 'Full Will nodig',
        fwTitle: 'Uw situatie vereist een Full Will.',
        fwReasons: {
          '5+': 'U heeft meer dan 5 vastgoedobjecten. Dit vereist juridische begeleiding via ons Tier 3-traject.',
          corporate: 'Uw vastgoed staat op naam van een bedrijf of holding. Een Property Will dekt dit niet.',
          assets: 'U wilt naast vastgoed ook andere bezittingen in de VAE opnemen. Dit vereist een Full Will.',
          guardianship: 'U wilt voogdij regelen voor minderjarige kinderen. Dit kan alleen via een Full Will.'
        },
        t1: ['Zelf & Zeker', '€497', 'Zelf registreren via ons portal, op uw eigen tempo', 'Kies Zelf & Zeker'],
        t2: ['Samen Registreren', '€797', '40 minuten begeleide portaalsessie (live video)', 'Kies Samen Registreren'],
        t3: ['Volledig Ontzorgd', '€1.499', 'Intake call + DIFC-jurist + volledige procesbegeleiding', 'Kies Volledig Ontzorgd'],
        priceNote: 'Begeleidingsvergoeding. DIFC-registratiekosten apart.',
        consult: 'Liever eerst overleggen? Plan een gratis gesprek →',
        fwConsult: 'Plan een gratis gesprek om uw situatie te bespreken →',
        nlLabel: 'Nog niet klaar om te beslissen?',
        nlBody: 'Krijg eens per maand een korte DIFC-update. Geen verkooppraat.',
        nlPlaceholder: 'uw@e-mailadres.nl',
        nlSubmit: 'Aanmelden'
      },
      en: {
        q: [
          ['How many properties in the UAE do you want to include?', 'Count all apartments, villas and other real estate.', ['1 property', '2 to 5 properties', 'More than 5 properties']],
          ['Is the property in your personal name?', 'Or held through an LLC, holding company, free zone entity or other legal structure?', ['Yes, in my personal name', 'No, through a company or holding']],
          ['Do you also want to include other UAE assets?', 'For example bank accounts, investments or vehicles in the UAE.', ['No, only real estate', 'Yes, other assets too']],
          ['Do you have minor children for whom you want to arrange guardianship?', 'Guardianship provisions can only be included through a Full Will.', ['No', 'Yes, I want to arrange guardianship']],
          ['Do you have a will in your home country?', 'This does not affect your DIFC will, but helps us advise you.', ['Yes, I have a home-country will', 'No, I do not have one']]
        ],
        pwBadge: 'Property Will',
        pwTitle: 'A Property Will covers your situation.',
        pwDesc: 'Your property is in your personal name, with no corporate structures, guardianship needs or non-real estate assets. A DIFC Property Will is the right choice.',
        pwDutchYes: 'Your DIFC will works alongside your existing home-country will.',
        pwDutchNo: 'Tip: consider also arranging a will in your home country for assets held there.',
        fwBadge: 'Full Will needed',
        fwTitle: 'Your situation requires a Full Will.',
        fwReasons: {
          '5+': 'You have more than 5 properties. This requires legal guidance via our Tier 3 service.',
          corporate: 'Your property is held through a company or holding. A Property Will does not cover this.',
          assets: 'You want to include non-real estate assets in the UAE. This requires a Full Will.',
          guardianship: 'You want to arrange guardianship for minor children. This can only be done through a Full Will.'
        },
        t2: ['Guided Registration', '€797', '40-minute guided portal session (live video)', 'Choose Guided Registration'],
        t3: ['Fully Managed', '€1,499', 'Intake call + DIFC lawyer + full process coordination', 'Choose Fully Managed'],
        priceNote: 'Guidance fee. DIFC registration costs separate.',
        consult: 'Prefer to discuss first? Schedule a free call →',
        fwConsult: 'Schedule a free call to discuss your situation →',
        nlLabel: 'Not ready to decide?',
        nlBody: 'Get a monthly DIFC update. No sales talk.',
        nlPlaceholder: 'your@email.com',
        nlSubmit: 'Subscribe'
      }
    };

    function detectLocale() {
      var lang = (document.documentElement.lang || '').substring(0, 2);
      if (lang === 'en') return 'en';
      if (window.location.pathname.indexOf('/en/') === 0) return 'en';
      return 'nl';
    }

    function t() { return S[locale]; }

    function populateText() {
      var s = t();
      for (var i = 0; i < totalSteps; i++) {
        var stepEl = document.querySelector('.tc-step[data-step="' + i + '"]');
        if (!stepEl) continue;
        stepEl.querySelector('h3').textContent = s.q[i][0];
        stepEl.querySelector('p').textContent = s.q[i][1];
        var opts = stepEl.querySelectorAll('.tc-opt');
        for (var j = 0; j < opts.length; j++) {
          opts[j].textContent = s.q[i][2][j] || '';
        }
      }
      document.getElementById('tcNLLabel').textContent = s.nlLabel;
      document.getElementById('tcNLBody').textContent = s.nlBody;
      document.getElementById('tcNLEmail').placeholder = s.nlPlaceholder;
      document.getElementById('tcNLSubmit').textContent = s.nlSubmit;
    }

    function makeTierBtn(tierKey, featured) {
      var s = t();
      var tier = s[tierKey];
      if (!tier) return null;
      var a = document.createElement('a');
      a.href = links[locale][tierKey];
      a.className = 'tc-tier-btn ' + (featured ? 'tc-tier-btn-gold' : 'tc-tier-btn-outline');
      a.innerHTML =
        '<div class="tc-tier-btn-left">' +
          '<span class="tc-tier-btn-name">' + tier[0] + '</span>' +
          '<span class="tc-tier-btn-desc">' + tier[2] + '</span>' +
        '</div>' +
        '<span class="tc-tier-btn-price">' + tier[1] + '</span>';
      return a;
    }

    function showPropertyWill() {
      var s = t();
      var card = document.getElementById('tcResultCard');
      card.className = 'tc-result-card tc-pw';
      document.getElementById('tcBadge').textContent = s.pwBadge;
      document.getElementById('tcResultHeading').textContent = s.pwTitle;
      document.getElementById('tcResultDesc').textContent = s.pwDesc;

      var dutchNote = document.getElementById('tcDutchNote');
      if (answers[4] === 'ja') {
        dutchNote.textContent = s.pwDutchYes;
      } else if (answers[4] === 'nee') {
        dutchNote.textContent = s.pwDutchNo;
      } else {
        dutchNote.textContent = '';
      }

      var btns = document.getElementById('tcTierBtns');
      btns.innerHTML = '';
      if (locale === 'nl' && s.t1) {
        btns.appendChild(makeTierBtn('t1', false));
      }
      btns.appendChild(makeTierBtn('t2', true));

      document.getElementById('tcPriceNote').textContent = s.priceNote;
      document.getElementById('tcConsultLink').textContent = s.consult;
      document.getElementById('tcConsultLink').href =
        'https://cal.com/vaetestament.nl/15min?utm_source=tier-check&utm_medium=modal' +
        (sourceSlug ? '&utm_content=' + sourceSlug : '');

      finishResult();
    }

    function showFullWill(reason) {
      var s = t();
      var card = document.getElementById('tcResultCard');
      card.className = 'tc-result-card tc-fw';
      document.getElementById('tcBadge').textContent = s.fwBadge;
      document.getElementById('tcResultHeading').textContent = s.fwTitle;
      document.getElementById('tcResultDesc').textContent = s.fwReasons[reason] || '';
      document.getElementById('tcDutchNote').textContent = '';

      var btns = document.getElementById('tcTierBtns');
      btns.innerHTML = '';
      btns.appendChild(makeTierBtn('t3', true));

      document.getElementById('tcPriceNote').textContent = s.priceNote;
      document.getElementById('tcConsultLink').textContent = s.fwConsult;
      document.getElementById('tcConsultLink').href =
        'https://cal.com/vaetestament.nl/15min?utm_source=tier-check&utm_medium=modal&utm_content=full-will' +
        (sourceSlug ? '-' + sourceSlug : '');

      finishResult();
    }

    function finishResult() {
      document.querySelectorAll('.tc-step').forEach(function (s) { s.classList.remove('active'); });
      document.querySelectorAll('#tcProgress span').forEach(function (b) { b.classList.add('done'); });
      document.getElementById('tcResult').classList.add('active');
    }

    function updateProgress() {
      var bars = document.querySelectorAll('#tcProgress span');
      for (var i = 0; i < bars.length; i++) {
        bars[i].classList.toggle('done', i <= step);
      }
    }

    function advanceTo(nextStep) {
      step = nextStep;
      document.querySelectorAll('.tc-step').forEach(function (s) { s.classList.remove('active'); });
      document.querySelector('.tc-step[data-step="' + step + '"]').classList.add('active');
      updateProgress();
    }

    window.openTierCheck = function (slug) {
      sourceSlug = typeof slug === 'string' ? slug : null;
      locale = detectLocale();
      answers = [];
      step = 0;

      populateText();

      document.querySelectorAll('.tc-step').forEach(function (s) { s.classList.remove('active'); });
      document.querySelector('.tc-step[data-step="0"]').classList.add('active');
      document.getElementById('tcResult').classList.remove('active');
      document.querySelectorAll('.tc-opt.selected').forEach(function (o) { o.classList.remove('selected'); });
      updateProgress();

      document.getElementById('tcOverlay').classList.add('open');
      document.body.style.overflow = 'hidden';
    };

    window.closeTierCheck = function () {
      document.getElementById('tcOverlay').classList.remove('open');
      document.body.style.overflow = '';
    };

    document.getElementById('tcClose').addEventListener('click', window.closeTierCheck);
    document.getElementById('tcOverlay').addEventListener('click', function (e) {
      if (e.target === this) window.closeTierCheck();
    });

    document.querySelectorAll('.tc-opt').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var q = parseInt(btn.getAttribute('data-q'), 10);
        var v = btn.getAttribute('data-v');
        answers[q] = v;

        document
          .querySelectorAll('.tc-step[data-step="' + q + '"] .tc-opt')
          .forEach(function (o) { o.classList.remove('selected'); });
        btn.classList.add('selected');

        setTimeout(function () {
          // T3 triggers: >5 properties, corporate, other assets, guardianship
          if (q === 0 && v === '5+') return showFullWill('5+');
          if (q === 1 && v === 'corporate') return showFullWill('corporate');
          if (q === 2 && v === 'ja') return showFullWill('assets');
          if (q === 3 && v === 'ja') return showFullWill('guardianship');

          // Last question answered -> Property Will
          if (q === totalSteps - 1) return showPropertyWill();

          // Advance to next question
          advanceTo(q + 1);
        }, 300);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && document.getElementById('tcOverlay').classList.contains('open')) {
        window.closeTierCheck();
      }
    });

    // Newsletter form binding (shared with NewsletterSignup.astro)
    document.querySelectorAll('.nl-form:not([data-nl-bound])').forEach(function (form) {
      form.setAttribute('data-nl-bound', 'true');
      var status = form.querySelector('.nl-status');
      var button = form.querySelector('button[type="submit"]');
      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var fd = new FormData(form);
        if (fd.get('website')) return;
        var email = (fd.get('email') || '').toString().trim();
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          status.textContent = locale === 'en' ? 'Please enter a valid email address.' : 'Voer een geldig e-mailadres in.';
          status.className = 'nl-status err';
          status.hidden = false;
          return;
        }
        button.disabled = true;
        status.textContent = locale === 'en' ? 'One moment…' : 'Even geduld…';
        status.className = 'nl-status';
        status.hidden = false;
        try {
          var res = await fetch('https://api.vaetestament.nl/v1/newsletter/subscribe', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email: email,
              slug: form.getAttribute('data-slug') || null,
              source: 'tier-check'
            })
          });
          if (!res.ok) throw new Error('subscribe ' + res.status);
          status.textContent = locale === 'en'
            ? 'Thank you. Check your inbox for a confirmation email.'
            : 'Bedankt. Check uw inbox voor een bevestigingse-mail.';
          status.className = 'nl-status ok';
          form.querySelector('input[type="email"]').value = '';
        } catch (err) {
          status.textContent = locale === 'en'
            ? 'Subscription failed. Please try again later.'
            : 'Aanmelden lukte niet. Probeer het later opnieuw of mail support@vaetestament.nl.';
          status.className = 'nl-status err';
        } finally {
          button.disabled = false;
        }
      });
    });
  })();
</script>
