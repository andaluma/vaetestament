---
// /over-andre — author authority page. Person JSON-LD + matching site chrome.

import BaseLayout from '../layouts/BaseLayout.astro';
import BookCallButton from '../components/BookCallButton.astro';

const canonical = 'https://vaetestament.nl/over-andre/';
const image = 'https://vaetestament.nl/andre-headshot.jpg';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': `${canonical}#person`,
  name: 'André van Wijngaarden',
  givenName: 'André',
  familyName: 'van Wijngaarden',
  alternateName: 'Adriaan van Wijngaarden',
  jobTitle: 'Oprichter VAEtestament',
  description:
    'Oprichter van VAEtestament. Begeleidt Nederlandse eigenaren van VAE-vastgoed bij het registreren van een DIFC-testament.',
  image,
  url: canonical,
  sameAs: ['https://www.linkedin.com/in/adriaanvanwijngaarden'],
  knowsAbout: [
    'DIFC Wills',
    'UAE inheritance law',
    'Dutch inheritance law',
    'Cross-border estate planning',
    'UAE real estate',
  ],
  knowsLanguage: ['nl', 'en', 'es'],
  worksFor: [
    {
      '@type': 'Organization',
      name: 'VAEtestament',
      legalName: 'Andaluma OÜ',
      url: 'https://vaetestament.nl',
    },
    {
      '@type': 'Organization',
      name: 'Baraca Capital',
      description: 'Portfolio Advisor',
    },
  ],
  email: 'mailto:support@vaetestament.nl',
};
---

<BaseLayout
  title="Over André van Wijngaarden — VAEtestament"
  description="Oprichter van VAEtestament. Begeleidt Nederlandse eigenaren van VAE-vastgoed bij het registreren van een DIFC-testament — volledig op afstand, in eigen taal."
  canonical={canonical}
  ogType="website"
  ogImage={image}
  jsonLd={[personJsonLd]}
>
  <main class="page">
    <section class="bio-hero">
      <div class="container">
        <div class="bio-hero-grid">
          <img
            src="/andre-headshot.jpg"
            alt="Portretfoto van André van Wijngaarden"
            width="260"
            height="325"
            loading="eager"
            fetchpriority="high"
          />
          <div>
            <span class="hero-eyebrow fade-up">Over de oprichter</span>
            <h1 class="fade-up delay-1">André van Wijngaarden</h1>
            <p class="bio-role fade-up delay-2">Oprichter van VAEtestament</p>
            <p class="bio-tagline fade-up delay-3">
              Maakt het DIFC-testament toegankelijk voor Nederlandse eigenaren van vastgoed in
              de Verenigde Arabische Emiraten. Volledig op afstand, in eigen taal.
            </p>
          </div>
        </div>
      </div>
    </section>

    <nav class="breadcrumbs">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">Over André</span>
    </nav>

    <article class="bio-body">
      <section>
        <p class="section-label">Achtergrond</p>
        <h2>Vanuit Dubai met portfolio's vol UAE-vastgoed</h2>
        <p>
          Ik ben Nederlander en werk in internationale sales- en advisory-rollen, met de laatste
          jaren een focus op vastgoed in de Verenigde Arabische Emiraten. Mijn werk als
          Portfolio Advisor bij Baraca Capital in Dubai brengt me dagelijks in contact met
          Nederlandse en internationale investeerders die in de Emiraten kopen, met name in
          Dubai, Abu Dhabi en Ras Al Khaimah. Mijn achtergrond ligt in commerciële en
          klantgerichte rollen, aangevuld met jaren ervaring als ondernemer in Peru.
        </p>
        <p>
          Daarnaast ben ik zelf actief als investeerder. Dat geeft me een direct perspectief op
          wat eigenaren in de VAE tegenkomen, en op de praktische vragen die ontstaan zodra een
          Nederlander vastgoed bezit in een ander rechtssysteem.
        </p>
        <p>
          Ik woon en werk locatie-onafhankelijk samen met mijn partner, en spreek Nederlands,
          Engels en Spaans vloeiend.
        </p>
      </section>

      <section>
        <p class="section-label">Waarom VAEtestament</p>
        <h2>Eén partij die het hele proces coördineert</h2>
        <p>
          VAEtestament ontstond uit een patroon dat ik bij Baraca steeds vaker tegenkwam:
          Nederlandse eigenaren van VAE-vastgoed die hun nalatenschap wilden regelen, maar
          nergens een coherent traject vonden. De procedure rondom een DIFC-Will is
          Engelstalig, vraagt om kennis van zowel Emirati erfrecht als de Nederlandse fiscale
          realiteit, en wordt door lokale notarissen vaak fragmentarisch behandeld. Mensen
          kregen losse antwoorden op losse vragen, maar nooit één overzicht.
        </p>
        <p>
          Daar is VAEtestament uit ontstaan: één partij die het hele proces coördineert, in uw
          taal, met begrip van uw situatie als Nederlandse non-resident.
        </p>
      </section>

      <section>
        <p class="section-label">Hoe ik werk</p>
        <h2>Coördinator en gids, geen advocaat</h2>
        <p>
          Ik ben geen advocaat en geef geen juridisch advies. Mijn rol is die van coördinator en
          gids: ik zorg dat uw DIFC-Will-registratie soepel verloopt van eerste vraag tot
          officiële inschrijving, vertaal complexe Emirati procedures naar begrijpelijke
          stappen, en regel de praktische logistiek namens u.
        </p>
        <p>
          Voor het strikt juridische werk en de officiële registratie werk ik samen met
          DIFC-erkende juristen in de VAE. Voor Nederlandse fiscale of erfrechtelijke vragen
          verwijs ik door naar adviseurs in Nederland. In de praktijk fungeer ik als brug
          tussen beide werelden, omdat de DIFC-context aan Nederlandse kant nog weinig
          gespecialiseerd is.
        </p>
      </section>

      <section class="cta-block" style="margin-top:64px;">
        <p class="section-label">Contact</p>
        <h2>Direct in gesprek</h2>
        <p>Plan een gratis kennismaking, mail support, of stuur een WhatsApp-bericht.</p>
        <div class="cta-row">
          <BookCallButton variant="primary" />
          <a href="mailto:support@vaetestament.nl" class="btn btn-outline">support@vaetestament.nl</a>
          <a href="https://wa.me/31616146007" target="_blank" rel="noopener" class="btn btn-outline">WhatsApp +31 6 16146007</a>
        </div>
        <p style="margin-top:1.5rem;font-size:0.85rem;color:var(--muted);">
          LinkedIn: <a href="https://www.linkedin.com/in/adriaanvanwijngaarden" rel="me noopener" target="_blank">linkedin.com/in/adriaanvanwijngaarden</a>
          · Entiteit: Andaluma OÜ (Estland), handelend onder de naam VAEtestament.
        </p>
      </section>
    </article>
  </main>
</BaseLayout>

<style>
  .bio-hero {
    background: var(--teal);
    padding: 148px 0 80px;
    margin-top: -68px;
    position: relative;
    overflow: hidden;
  }
  .bio-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 80% 30%, rgba(200, 164, 74, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse 40% 60% at 8% 85%, rgba(30, 114, 104, 0.4) 0%, transparent 60%);
    pointer-events: none;
  }
  .bio-hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 880px;
  }
  .bio-hero img {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid rgba(200, 164, 74, 0.3);
  }
  .bio-hero h1 {
    color: #fff;
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0 0 0.5rem;
  }
  .bio-role {
    font-family: var(--font-body);
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 1.5rem;
  }
  .bio-tagline {
    color: rgba(255, 255, 255, 0.82);
    font-size: 1.1rem;
    line-height: 1.6;
    font-weight: 300;
    margin: 0;
  }
  .bio-body {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 1.25rem 24px;
  }
  .bio-body section { margin: 56px 0; }
  .bio-body section:first-child { margin-top: 0; }
  .bio-body section h2 {
    margin: 0 0 1.2rem;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
  }
  .bio-body p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--body);
  }
  @media (max-width: 720px) {
    .bio-hero { padding: 130px 0 56px; }
    .bio-hero-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .bio-hero img { max-width: 200px; }
  }
</style>
