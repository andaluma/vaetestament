  .faq-disclaimer { text-align: center; margin-top: 40px; font-size: 0.78rem; color: var(--light-text); font-weight: 300; max-width: 680px; margin-left: auto; margin-right: auto; }

  @media (max-width: 900px) {
    .problem .container, .solution-inner, .about-inner { grid-template-columns: 1fr; gap: 48px; }
