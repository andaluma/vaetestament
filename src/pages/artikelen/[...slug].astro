---
// Dynamic article route — renders every entry in the `articles` collection
// at /artikelen/{slug}. Visual design mirrors the live homepage:
// teal hero with gold gradient + optional Unsplash overlay, then a
// cream-background article body with drop-cap lede + gold-accented h2s,
// related-articles grid, FAQ block, and CTA card.

import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TierCheckButton from '../../components/TierCheckButton.astro';
import BookCallButton from '../../components/BookCallButton.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

// Universal fallback hero image — Dubai skyline by ZQ Lee on Unsplash.
// Each article can override via frontmatter `hero_image`. The image sits
// under a teal/gold radial gradient at ~18% opacity, so it reads as a
// subtle backdrop rather than a photo banner.
const DEFAULT_HERO =
  'https://images.unsplash.com/photo-1518684079-3c830dcef090?w=1600&q=85&auto=format&fit=crop';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((entry) => ({
    params: { slug: entry.id.replace(/\.(md|mdx)$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const data = entry.data;
const slug = entry.id.replace(/\.(md|mdx)$/, '');
const canonical = `https://vaetestament.nl/artikelen/${slug}/`;
const heroImage = data.hero_image || DEFAULT_HERO;

// Reading-time estimate — 200 wpm Dutch nonfiction.
const bodyText = entry.body ?? '';
const wordCount = bodyText.split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// Resolve related-article entries.
const allArticles = await getCollection('articles');
const slugIndex = new Map(
  allArticles.map((a) => [a.id.replace(/\.(md|mdx)$/, ''), a]),
);
const relatedEntries = (data.related ?? [])
  .map((s) => slugIndex.get(s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

// JSON-LD
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': data.schema_type,
  headline: data.title,
  description: data.meta_description,
  image: heroImage,
  datePublished: data.publish_date.toISOString(),
  ...(data.updated_date && { dateModified: data.updated_date.toISOString() }),
  author: {
    '@type': 'Person',
    name: data.author,
    url: 'https://vaetestament.nl/over-andre',
  },
  publisher: {
    '@type': 'Organization',
    name: 'VAEtestament',
    legalName: 'Andaluma OÜ',
    url: 'https://vaetestament.nl',
    logo: {
      '@type': 'ImageObject',
      url: 'https://vaetestament.nl/favicon.png',
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  keywords: data.keywords.join(', '),
  inLanguage: 'nl-NL',
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vaetestament.nl/' },
    { '@type': 'ListItem', position: 2, name: 'Artikelen', item: 'https://vaetestament.nl/artikelen/' },
    { '@type': 'ListItem', position: 3, name: data.title, item: canonical },
  ],
};

const faqJsonLd =
  data.faq.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: data.faq.map((qa) => ({
          '@type': 'Question',
          name: qa.q,
          acceptedAnswer: { '@type': 'Answer', text: qa.a },
        })),
      }
    : null;

const jsonLd = [articleJsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const clusterLabels: Record<string, string> = {
  waarom: 'Waarom dit telt',
  hoe: 'Hoe het werkt',
  keuze: 'Welke keuze past bij u',
};
const clusterLabel = clusterLabels[data.cluster] ?? null;

const publishDateFmt = data.publish_date.toLocaleDateString('nl-NL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout
  title={`${data.title} — VAEtestament`}
  description={data.meta_description}
  canonical={canonical}
  ogType="article"
  ogImage={heroImage}
  publishDate={data.publish_date}
  updatedDate={data.updated_date}
  author={data.author}
  jsonLd={jsonLd}
  articleSlug={slug}
  articleTitle={data.title}
>
  <main class="page">
    <section
      class={`article-hero ${heroImage ? 'has-image' : ''}`}
      style={`--hero-image: url('${heroImage}')`}
    >
      <div class="container">
        {clusterLabel && <span class="hero-eyebrow fade-up">{clusterLabel}</span>}
        <h1 class="fade-up delay-1">{data.title}</h1>
        <p class="lede fade-up delay-2">{data.meta_description}</p>
        <p class="meta fade-up delay-3">
          <span>Door <a href="/over-andre/" rel="author">{data.author}</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={data.publish_date.toISOString()}>{publishDateFmt}</time>
          <span aria-hidden="true">·</span>
          <span>{readMinutes} min lezen</span>
        </p>
      </div>
    </section>

    <nav class="breadcrumbs" aria-label="Broodkruimels">
      <a href="/">Home</a>
      <span aria-hidden="true"> › </span>
      <a href="/artikelen/">Artikelen</a>
      <span aria-hidden="true"> › </span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <article class="article-body">
      <Content />
    </article>

    <section class="cta-block" aria-labelledby="cta-heading">
      <p class="section-label">Volgende stap</p>
      <h2 id="cta-heading">Welk pakket past bij uw situatie?</h2>
      <p>Vijf korte vragen en u weet welke tier het beste bij u past. Of plan eerst een vrijblijvend gesprek van vijftien minuten.</p>
      <div class="cta-row">
        <button
          type="button"
          class="btn btn-gold btn-lg"
          onclick={`openTierCheck(${JSON.stringify(slug)})`}
        >Welk pakket past bij u?</button>
        <BookCallButton slug={slug} cluster={data.cluster} variant="subtle" />
      </div>
    </section>

    {data.faq.length > 0 && (
      <section class="faq-block" aria-labelledby="faq-heading">
        <p class="section-label">Veelgestelde vragen</p>
        <h2 id="faq-heading">Wat lezers vaak vragen</h2>
        {data.faq.map((qa) => (
          <div class="faq-item">
            <h3>{qa.q}</h3>
            <p>{qa.a}</p>
          </div>
        ))}
      </section>
    )}

    {relatedEntries.length > 0 && (
      <section class="related-block" aria-labelledby="related-heading">
        <p class="section-label" style="text-align:center;display:block;">Verder lezen</p>
        <h2 id="related-heading">Gerelateerde artikelen</h2>
        <ul class="related-list">
          {relatedEntries.map((rel) => {
            const relSlug = rel.id.replace(/\.(md|mdx)$/, '');
            return (
              <li>
                <a href={`/artikelen/${relSlug}/`}>
                  <strong>{rel.data.title}</strong>
                  <span>{rel.data.meta_description}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </main>
</BaseLayout>
